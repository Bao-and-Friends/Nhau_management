<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Primary Colors (Ấm áp F&B) -->
    <Color x:Key="PrimaryColor">#FF6B35</Color>
    <Color x:Key="PrimaryHoverColor">#EA580C</Color>
    <Color x:Key="PrimaryPressedColor">#C2410C</Color>
    <Color x:Key="PrimarySoftColor">#FFF7ED</Color>

    <!-- Neutral & Backgrounds -->
    <Color x:Key="AppBackgroundColor">#F8FAFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SidebarBgColor">#0F172A</Color>
    <Color x:Key="SidebarActiveColor">#1E293B</Color>
    <Color x:Key="SidebarHoverColor">#1E293B</Color>

    <!-- Borders & Dividers -->
    <Color x:Key="BorderSubtleColor">#E2E8F0</Color>
    <Color x:Key="BorderStrongColor">#CBD5E1</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="TextMutedColor">#94A3B8</Color>
    <Color x:Key="TextLightColor">#FFFFFF</Color>

    <!-- Status Colors (Trạng thái bàn & Đơn hàng) -->
    <Color x:Key="TableAvailableColor">#10B981</Color>
    <!-- Bàn trống: Xanh ngọc -->
    <Color x:Key="TableOccupiedColor">#EF4444</Color>
    <!-- Có khách: Đỏ san hô -->
    <Color x:Key="TableReservedColor">#3B82F6</Color>
    <!-- Đã đặt: Xanh dương -->
    <Color x:Key="TableBillReadyColor">#F59E0B</Color>
    <!-- Cần thanh toán: Vàng hổ phách -->

    <!-- SOLID COLOR BRUSHES -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}"/>

    <SolidColorBrush x:Key="TableAvailableBrush" Color="{StaticResource TableAvailableColor}"/>
    <SolidColorBrush x:Key="TableOccupiedBrush" Color="{StaticResource TableOccupiedColor}"/>
    <SolidColorBrush x:Key="TableReservedBrush" Color="{StaticResource TableReservedColor}"/>
    <SolidColorBrush x:Key="TableBillReadyBrush" Color="{StaticResource TableBillReadyColor}"/>

</ResourceDictionary>