<Window x:Class="RestaurantManagement.WPF.Views.RegisterStaffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vms="clr-namespace:RestaurantManagement.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Đăng ký nhân viên mới" 
        Height="650" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vms:RegisterStaffViewModel />
    </Window.DataContext>

    <Border CornerRadius="16" Background="{StaticResource SurfaceBrush}" 
            BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000" />
        </Border.Effect>

        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Error Alert -->
                <RowDefinition Height="Auto" />
                <!-- Form Inputs -->
                <RowDefinition Height="*" />
                <!-- Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,12,0">
                        <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Đăng ký nhân viên &amp; Cấp tài khoản" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Chức năng dành riêng cho Quản trị viên / Quản lý" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Nút Đóng -->
                <Button Content="✕" Width="32" Height="32" Background="Transparent" BorderThickness="0" 
                        Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Cursor="Hand" HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>

            <!-- 2. ERROR ALERT -->
            <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" 
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ " Foreground="#B91C1C" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 3. FORM 2 CỘT -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: HỒ SƠ NHÂN VIÊN -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="1. THÔNG TIN HỒ SƠ" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Mã NV & Giới tính -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã NV" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding MaNV, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Giới tính" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding GendersList}" SelectedItem="{Binding GioiTinh}" Height="38" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Họ và tên -->
                    <TextBlock Text="Họ và tên nhân viên *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" Margin="0,0,0,10" />

                    <!-- Số điện thoại -->
                    <TextBlock Text="Số điện thoại (dùng nhận OTP) *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" Margin="0,0,0,10" />

                    <!-- Địa chỉ -->
                    <TextBlock Text="Địa chỉ thường trú" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                </StackPanel>

                <!-- CỘT PHẢI: VAI TRÒ & TÀI KHOẢN -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="2. VAI TRÒ &amp; TÀI KHOẢN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Chức vụ / Vai trò -->
                    <TextBlock Text="Chức vụ / Vai trò *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RolesList}" SelectedItem="{Binding VaiTro}" Height="38" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <!-- Tên đăng nhập -->
                    <TextBlock Text="Tên đăng nhập hệ thống *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" Margin="0,0,0,10" />

                    <!-- Mật khẩu khởi tạo -->
                    <TextBlock Text="Mật khẩu khởi tạo *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" Margin="0,0,0,10" />

                    <!-- Xác nhận mật khẩu -->
                    <TextBlock Text="Xác nhận mật khẩu *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ConfirmMatKhau, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                </StackPanel>
            </Grid>

            <!-- 4. ACTION BUTTONS -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Button Content="Hủy bỏ" Width="100" Height="42" Background="Transparent" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Cursor="Hand" HorizontalAlignment="Left"
                        Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />

                <Button Content="TẠO TÀI KHOẢN" Style="{StaticResource PrimaryButton}" Width="180" Height="42" HorizontalAlignment="Right"
                        Command="{Binding RegisterStaffCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
