<UserControl x:Class="RestaurantManagement.WPF.Views.Pages.TableManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:RestaurantManagement.WPF.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Thanh lọc trạng thái và tìm kiếm -->
            <RowDefinition Height="60" />
            <!-- 2. Vùng danh sách bàn + Panel chi tiết -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. FILTER BAR ==================== -->
        <Border Grid.Row="0" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Các nút Filter theo trạng thái kèm số lượng -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tất cả bàn" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,0" Margin="0,0,8,0"
                            Command="{Binding ApplyFilterCommand}" CommandParameter="Tất cả" />

                    <Button Height="38" Padding="14,0" Margin="0,0,8,0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand"
                            Command="{Binding ApplyFilterCommand}" CommandParameter="Trống">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource TableAvailableBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding AvailableCount, StringFormat='Trống ({0})'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Height="38" Padding="14,0" Margin="0,0,8,0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand"
                            Command="{Binding ApplyFilterCommand}" CommandParameter="Có khách">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource TableOccupiedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding OccupiedCount, StringFormat='Có khách ({0})'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Height="38" Padding="14,0" Margin="0,0,8,0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand"
                            Command="{Binding ApplyFilterCommand}" CommandParameter="Đã đặt">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource TableReservedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ReservedCount, StringFormat='Đã đặt ({0})'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <Button Height="38" Padding="14,0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Cursor="Hand"
                            Command="{Binding ApplyFilterCommand}" CommandParameter="Chờ Dọn">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource TableBillReadyBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding BillReadyCount, StringFormat='Chờ Dọn ({0})'}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nút Làm mới -->
                <Button Grid.Column="1" Content="🔄 Tải lại" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Height="38" Padding="16,0"
                        Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Cursor="Hand"
                        Command="{Binding LoadTablesCommand}" />
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN AREA: LƯỚI BÀN + DETAIL PANEL ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Lưới thẻ bàn (co dãn tự do) -->
                <ColumnDefinition Width="*" />
                <!-- Cột phải: Panel Thao tác bàn (320px) -->
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- LƯỚI BÀN ĂN (Dùng ItemsControl + WrapPanel) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <ItemsControl ItemsSource="{Binding FilteredTables}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TableDisplayModel}">
                            <!-- Thẻ 1 bàn ăn -->
                            <Button Margin="0,0,16,16" Width="180" Height="140" Cursor="Hand"
                                    Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cardBorder" Style="{StaticResource ModernCard}" Padding="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Header bàn: Tên bàn + Badge sức chứa -->
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding TenBan}" FontWeight="Bold" FontSize="16" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <Border HorizontalAlignment="Right" Background="{StaticResource AppBackgroundBrush}" 
                                                            CornerRadius="6" Padding="6,2">
                                                        <TextBlock Text="{Binding SucChua, StringFormat='👤 {0}'}" FontSize="11" 
                                                                   Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Body: Badge Trạng thái trực quan -->
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8">
                                                    <Border Background="{Binding StatusBadgeBg}" CornerRadius="12" 
                                                            Padding="10,4" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding TrangThai}" FontWeight="Bold" FontSize="12" 
                                                                       Foreground="{Binding StatusBrush}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="{Binding ThoiGianVao}" FontSize="11" 
                                                               Foreground="{StaticResource TextMutedBrush}" Margin="2,4,0,0"/>
                                                </StackPanel>

                                                <!-- Footer: Tiền tạm tính (nếu có) -->
                                                <TextBlock Grid.Row="2" Text="{Binding TamTinhFormatted}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- PANEL THAO TÁC BÀN BÊN PHẢI -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Tiêu đề bàn đang chọn -->
                        <RowDefinition Height="Auto" />
                        <!-- Thông tin chi tiết -->
                        <RowDefinition Height="*" />
                        <!-- Các nút bấm nghiệp vụ -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header Panel -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedTable.TenBan, FallbackValue='Chưa chọn bàn'}" 
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SelectedTable.KhuVuc, FallbackValue='Khu vực: --'}" 
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,12"/>
                        <Separator Background="{StaticResource BorderSubtleBrush}"/>
                    </StackPanel>

                    <!-- Body Panel -->
                    <StackPanel Grid.Row="1" Margin="0,16">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Trạng thái:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedTable.TrangThai, FallbackValue='--'}" 
                                       FontWeight="Bold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Sức chứa tối đa:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedTable.SucChua, StringFormat='{}{0} người', FallbackValue='--'}" 
                                       FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Thời gian ngồi:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedTable.ThoiGianVao, FallbackValue='--'}" 
                                       FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="13"/>
                        </Grid>

                        <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Tạm tính:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedTable.TamTinhFormatted, FallbackValue='0 đ'}" 
                                           FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2">
                        <!-- Nút Mở bàn / Gọi món -->
                        <Button Content="🍽️ Vào bàn / Gọi món (POS)" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" />

                        <!-- Nút Chuyển / Gộp bàn -->
                        <Button Content="🔄 Chuyển / Gộp bàn" Height="40" Margin="0,0,0,10"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" />

                        <!-- Nút Thanh toán -->
                        <Button Content="💳 Thanh toán hóa đơn" Height="40" Margin="0,0,0,10"
                                Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />

                        <!-- Nút Dọn bàn -->
                        <Button Content="🧹 Dọn xong bàn (Về trống)" Height="38" Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand"
                                Command="{Binding ClearTableCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>