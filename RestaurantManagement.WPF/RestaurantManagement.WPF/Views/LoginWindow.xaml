<Window x:Class="RestaurantManagement.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vms="clr-namespace:RestaurantManagement.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Đăng nhập - The Gourmet POS" 
        Height="540" Width="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Khung Card chính bo tròn 16px, đổ bóng mượt mà -->
    <Border CornerRadius="16" Background="{StaticResource SurfaceBrush}" 
            BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6" Opacity="0.18" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Brand Hero Banner (360px) -->
                <ColumnDefinition Width="360" />
                <!-- Cột phải: Form Đăng nhập (500px) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== NỬA TRÁI: BRAND BANNER ==================== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <Grid Margin="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo & Brand Header -->
                    <StackPanel Grid.Row="0">
                        <Border Width="50" Height="50" CornerRadius="12" Background="{StaticResource PrimaryBrush}" 
                                HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="TG" Foreground="White" FontWeight="Bold" FontSize="22" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="THE GOURMET" Foreground="{StaticResource TextLightBrush}" 
                                   FontWeight="Bold" FontSize="22" />
                        <TextBlock Text="Restaurant Management System" Foreground="{StaticResource TextMutedBrush}" 
                                   FontSize="13" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Danh sách tính năng nổi bật -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Đồng bộ sơ đồ bàn Real-time" Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🍽️" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Gọi món POS &amp; Báo bếp tức thì" Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Tách gộp bàn &amp; Thanh toán VietQR" Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Phiên bản ở chân banner -->
                    <TextBlock Grid.Row="2" Text="v2.0 Clean MVVM (.NET 10)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </Grid>
            </Border>

            <!-- ==================== NỬA PHẢI: FORM ĐĂNG NHẬP ==================== -->
            <Grid Grid.Column="1" Margin="44,28,44,28">
                <Grid.RowDefinitions>
                    <!-- Nút Đóng / Thu nhỏ -->
                    <RowDefinition Height="Auto" />
                    <!-- Tiêu đề Form -->
                    <RowDefinition Height="Auto" />
                    <!-- Khung báo lỗi -->
                    <RowDefinition Height="Auto" />
                    <!-- Các ô nhập liệu -->
                    <RowDefinition Height="*" />
                    <!-- Chân form -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Window Controls (Thu nhỏ & Đóng) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Width="32" Height="32" Background="Transparent" BorderThickness="0" 
                            Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Cursor="Hand"
                            Command="{Binding MinimizeAppCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    
                    <Button Content="✕" Width="32" Height="32" Background="Transparent" BorderThickness="0" 
                            Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Cursor="Hand" Margin="4,0,0,0"
                            Command="{Binding CloseAppCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#EF4444" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="1" Margin="0,4,0,18">
                    <TextBlock Text="Đăng nhập" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Nhập tài khoản nhân viên để bắt đầu ca làm việc" 
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Khung thông báo lỗi (Error Alert Box) -->
                <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" 
                        CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ " Foreground="#B91C1C" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Các trường nhập dữ liệu -->
                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                    <!-- Tên đăng nhập -->
                    <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,16" />

                    <!-- Mật khẩu -->
                    <TextBlock Text="Mật khẩu" FontWeight="SemiBold" FontSize="13" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="pwdBox" Height="42" Padding="12,0" VerticalContentAlignment="Center"
                                 FontSize="14" Foreground="{StaticResource TextPrimaryBrush}">
                        <!-- Template PasswordBox bo góc chuẩn Styles -->
                        <PasswordBox.Template>
                            <ControlTemplate TargetType="PasswordBox">
                                <Border x:Name="border" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="8" SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                        <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </PasswordBox.Template>
                    </PasswordBox>

                    <!-- Ghi nhớ tài khoản + Quên mật khẩu trên cùng 1 hàng -->
                    <Grid Margin="0,14,0,20">
                        <CheckBox Content="Ghi nhớ tài khoản" 
                                  IsChecked="{Binding RememberMe}"
                                  FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" 
                                  VerticalAlignment="Center" Cursor="Hand" />
                        <Button Content="Quên mật khẩu?" 
                                Command="{Binding OpenForgotPasswordCommand}"
                                HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                    </Grid>

                    <!-- Nút Đăng nhập -->
                    <Button Content="ĐĂNG NHẬP" Style="{StaticResource PrimaryButton}" Height="44" FontSize="15"
                            IsDefault="True"
                            Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=pwdBox}" />
                </StackPanel>

                <!-- Ghi chú tài khoản Demo ở chân trang -->
                <TextBlock Grid.Row="4" Text="💡 Gợi ý: nguyenvana / 123456 (Thu ngân) hoặc tranthib / 123456 (Quản lý)" 
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
