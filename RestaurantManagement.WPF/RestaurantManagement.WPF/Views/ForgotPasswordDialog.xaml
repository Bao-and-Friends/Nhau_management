<Window x:Class="RestaurantManagement.WPF.Views.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vms="clr-namespace:RestaurantManagement.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Quên mật khẩu" 
        Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vms:ForgotPasswordViewModel />
    </Window.DataContext>

    <Border CornerRadius="16" Background="{StaticResource SurfaceBrush}" 
            BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="5" Opacity="0.15" Color="#000000" />
        </Border.Effect>

        <Grid Margin="32,24">
            <Grid.RowDefinitions>
                <!-- Header có nút đóng -->
                <RowDefinition Height="Auto" />
                <!-- Stepper Progress Bar -->
                <RowDefinition Height="Auto" />
                <!-- Alert Error -->
                <RowDefinition Height="Auto" />
                <!-- Dynamic Content for Steps -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,12,0">
                        <TextBlock Text="🔑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Khôi phục mật khẩu" FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Nút Đóng -->
                <Button Content="✕" Width="30" Height="30" Background="Transparent" BorderThickness="0" 
                        Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Cursor="Hand" HorizontalAlignment="Right"
                        Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>

            <!-- 2. STEPPER CHỈ BÁO TIẾN TRÌNH -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Bước 1 -->
                <Border Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,4,0" Background="{StaticResource PrimaryBrush}" />

                <!-- Bước 2 -->
                <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="2,0,2,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="4">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Bước 3 -->
                <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="4,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Step}" Value="4">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>

            <!-- 3. ERROR ALERT BAR -->
            <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" 
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ " Foreground="#B91C1C" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 4. STEP CONTENTS -->
            <Grid Grid.Row="3">
                <!-- ================= BƯỚC 1: NHẬP SỐ ĐIỆN THOẠI ================= -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Xác thực Số điện thoại" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Nhập số điện thoại đã đăng ký trong hồ sơ nhân viên để nhận mã xác thực OTP." 
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <TextBlock Text="Số điện thoại" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,24" />

                    <Button Content="GỬI MÃ OTP" Style="{StaticResource PrimaryButton}" Height="42" IsDefault="True"
                            Command="{Binding SendOtpCommand}" />
                </StackPanel>

                <!-- ================= BƯỚC 2: NHẬP MÃ OTP ================= -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Nhập mã xác thực OTP" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PhoneNumber, StringFormat='Mã OTP 6 số đã được gửi tới SĐT {0}'}" 
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />

                    <!-- HỘP MÔ PHỎNG TIN NHẮN SMS GIẢ LẬP -->
                    <Border Background="#F1F5F9" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5"
                            CornerRadius="10" Padding="12" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SimulatedSmsMessage}" Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Mã OTP 6 số" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CountdownText}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    
                    <TextBox Text="{Binding OtpInput, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}" Height="42" FontSize="16" FontWeight="Bold" 
                             HorizontalContentAlignment="Center" Margin="0,0,0,16" MaxLength="6" />

                    <Button Content="XÁC NHẬN MÃ OTP" Style="{StaticResource PrimaryButton}" Height="42" IsDefault="True"
                            Command="{Binding VerifyOtpCommand}" Margin="0,0,0,12" />

                    <Button Content="Gửi lại mã OTP" Background="Transparent" BorderThickness="0" 
                            Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                            IsEnabled="{Binding CanResendOtp}" Command="{Binding ResendOtpCommand}" />
                </StackPanel>

                <!-- ================= BƯỚC 3: ĐẶT MẬT KHẨU MỚI ================= -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Đặt lại mật khẩu mới" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StaffName, StringFormat='Xin chào {0}, hãy tạo mật khẩu mới cho tài khoản.'}" 
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" />

                    <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,12" />

                    <TextBlock Text="Xác nhận mật khẩu mới" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,24" />

                    <Button Content="LƯU MẬT KHẨU MỚI" Style="{StaticResource PrimaryButton}" Height="42" IsDefault="True"
                            Command="{Binding ResetPasswordCommand}" />
                </StackPanel>

                <!-- ================= BƯỚC 4: THÀNH CÔNG ================= -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="4">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Width="64" Height="64" CornerRadius="32" Background="#ECFDF5" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="✓" Foreground="{StaticResource TableAvailableBrush}" FontWeight="Bold" FontSize="32" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    
                    <TextBlock Text="Đổi mật khẩu thành công!" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Mật khẩu tài khoản của bạn đã được cập nhật. Bạn có thể đăng nhập ngay bằng mật khẩu mới." 
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,24" />

                    <Button Content="ĐĂNG NHẬP NGAY" Style="{StaticResource PrimaryButton}" Height="42" Width="200"
                            Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
