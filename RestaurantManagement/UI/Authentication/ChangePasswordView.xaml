<UserControl x:Class="RestaurantClient.UI.Authentication.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Background="{StaticResource ColorAppBg}">
        <Border Width="420" Style="{StaticResource CardContainerStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
            <StackPanel>
                <TextBlock Text="Đặt Mật Khẩu Mới" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Vui lòng thiết lập mật khẩu mới cho tài khoản của bạn" FontSize="13" Foreground="{StaticResource ColorTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Mật khẩu mới:" FontWeight="SemiBold" Foreground="{StaticResource ColorTextPrimary}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtNewPassword" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="Xác nhận mật khẩu mới:" FontWeight="SemiBold" Foreground="{StaticResource ColorTextPrimary}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtConfirmPassword" Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,24"/>

                <Button x:Name="btnChangePassword" Content="ĐỔI MẬT KHẨU" Style="{StaticResource PrimaryButtonStyle}" Height="45" Click="BtnChangePassword_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
