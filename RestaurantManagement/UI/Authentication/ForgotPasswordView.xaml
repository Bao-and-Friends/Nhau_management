<UserControl x:Class="RestaurantClient.UI.Authentication.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1440"
             FontFamily="Segoe UI, Inter"
             Background="{StaticResource ColorAppBg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid MinWidth="1200" MinHeight="800" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Status Island (Figma: Đảo trạng thái) -->
                <RowDefinition Height="*"/>    <!-- Main Presentation Grid -->
                <RowDefinition Height="Auto"/> <!-- Footer Copyright -->
            </Grid.RowDefinitions>

            <!-- ================= TOP STATUS ISLAND ================= -->
            <Border Grid.Row="0" 
                    Background="{StaticResource ColorPrimary}" 
                    CornerRadius="22" 
                    Height="44" 
                    Width="256" 
                    HorizontalAlignment="Center" 
                    Margin="0,16,0,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.08" Color="#0F172A"/>
                </Border.Effect>
                <TextBlock x:Name="lblStatusIsland" 
                           Text="KHÔI PHỤC MẬT KHẨU" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource ColorTextWhite}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Border>

            <!-- ================= MAIN DUAL-CARD GRID ================= -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="648"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: BRAND & SUPPORT CARDS ================= -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Brand Card (Figma node 17:12: Thẻ thương hiệu) -->
                    <Border Background="{StaticResource ColorPrimary}" 
                            CornerRadius="32" 
                            Padding="40" 
                            Margin="0,0,0,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="8" Opacity="0.08" Color="#0F172A"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Nhà hàng Gourmet" 
                                       FontSize="22" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextWhite}" 
                                       Margin="0,0,0,24"/>

                            <TextBlock Text="KHÔNG GIAN LÀM VIỆC" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextBrandMuted}" 
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Làm việc hiệu quả,&#x0a;bắt đầu từ đây." 
                                       FontSize="34" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextWhite}" 
                                       LineHeight="44" 
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="Một không gian để quản lý công việc và kết nối." 
                                       FontSize="15" 
                                       Foreground="{StaticResource ColorTextBrandMuted}" 
                                       Margin="0,0,0,28"/>

                            <!-- Message Pill (Figma node 17:10: Thông điệp thương hiệu) -->
                            <Border Background="{StaticResource ColorSidebarBg}" 
                                    CornerRadius="15" 
                                    Height="32" 
                                    HorizontalAlignment="Left" 
                                    Padding="16,6">
                                <TextBlock Text="Sẵn sàng cho một ngày hiệu quả" 
                                           FontSize="11" 
                                           FontWeight="Medium" 
                                           Foreground="{StaticResource ColorTextWhite}" 
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Feature Support Cards Row (Figma node 17:20 & 17:29) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="252"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="208"/>
                        </Grid.ColumnDefinitions>

                        <!-- Productivity Card (Thẻ năng suất) -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource ColorCardBg}" 
                                BorderBrush="{StaticResource ColorBorder}" 
                                BorderThickness="1" 
                                CornerRadius="28" 
                                Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.04" Color="#0F172A"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Background="{StaticResource ColorAppBg}" CornerRadius="16" Width="44" Height="32" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <TextBlock Text="🎯" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tập trung điều&#x0a;quan trọng." 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource ColorTextDark}" 
                                           LineHeight="22" 
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Sắp xếp gọn gàng.&#x0a;Làm việc nhẹ nhàng hơn." 
                                           FontSize="11" 
                                           Foreground="{StaticResource ColorTextSecondary}" 
                                           LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Security Card (Thẻ bảo mật) -->
                        <Border Grid.Column="2" 
                                Background="{StaticResource ColorCardBg}" 
                                BorderBrush="{StaticResource ColorBorder}" 
                                BorderThickness="1" 
                                CornerRadius="28" 
                                Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.04" Color="#0F172A"/>
                            </Border.Effect>
                            <StackPanel>
                                <Border Background="{StaticResource ColorAppBg}" CornerRadius="16" Width="44" Height="32" HorizontalAlignment="Left" Margin="0,0,0,16">
                                    <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="An toàn và&#x0a;bảo mật." 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource ColorTextDark}" 
                                           LineHeight="22" 
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="An tâm mỗi lần&#x0a;truy cập." 
                                           FontSize="11" 
                                           Foreground="{StaticResource ColorTextSecondary}" 
                                           LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ================= RIGHT COLUMN: RECOVERY WORKFLOW CARD ================= -->
                <!-- Figma node 17:116: Thẻ khôi phục mật khẩu (648x620) -->
                <Border Grid.Column="2" 
                        Background="{StaticResource ColorCardBg}" 
                        BorderBrush="{StaticResource ColorBorder}" 
                        BorderThickness="1" 
                        CornerRadius="32" 
                        Padding="56,36,56,36" 
                        VerticalAlignment="Center"
                        MinHeight="620">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" Direction="270" ShadowDepth="8" Opacity="0.06" Color="#0F172A"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Top Accent Pill (Figma: Điểm nhấn dạng viên) -->
                        <Border Background="{StaticResource ColorPrimary}" 
                                CornerRadius="3" 
                                Width="52" 
                                Height="6" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,24"/>

                        <!-- ================= STEP 1: XÁC ĐỊNH TÀI KHOẢN (Frames 01 - 05) ================= -->
                        <StackPanel x:Name="pnlStep1" Visibility="Visible">
                            <TextBlock Text="Quên mật khẩu?" 
                                       FontSize="30" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="Nhập địa chỉ thư điện tử đã đăng ký.&#x0a;Tôi sẽ gửi mã xác minh để bạn đặt lại mật khẩu." 
                                       FontSize="15" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       LineHeight="22" 
                                       Margin="0,0,0,24"/>

                            <TextBlock Text="Địa chỉ thư điện tử hoặc tên đăng nhập" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="txtEmail" 
                                     Style="{StaticResource ModernRoundedTextBoxStyle}" 
                                     Text="" 
                                     Margin="0,0,0,8"
                                     TextChanged="TxtEmail_TextChanged"
                                     KeyDown="TxtEmail_KeyDown"/>

                            <TextBlock x:Name="lblEmailHelper" 
                                       Text="Sử dụng địa chỉ thư điện tử liên kết với tài khoản." 
                                       FontSize="13" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       Margin="0,0,0,24"/>

                            <Button x:Name="btnSendOtp" 
                                    Content="Gửi mã xác minh" 
                                    Style="{StaticResource LoginPillButtonStyle}" 
                                    Margin="0,0,0,20" 
                                    Click="BtnSendOtp_Click"/>

                            <TextBlock Text="Quay lại đăng nhập" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorAccent}" 
                                       HorizontalAlignment="Center" 
                                       Cursor="Hand" 
                                       Margin="0,0,0,32"
                                       MouseLeftButtonUp="LinkBackToLogin_Click"/>

                            <TextBlock Text="Bước 1 / 3 · Xác định tài khoản" 
                                       FontSize="12" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- ================= STEP 2: XÁC MINH OTP 6 SỐ (Frames 06 - 12, 20) ================= -->
                        <StackPanel x:Name="pnlStep2" Visibility="Collapsed">
                            <TextBlock x:Name="lblOtpTitle" 
                                       Text="Xác minh thư điện tử" 
                                       FontSize="30" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="lblOtpDesc" 
                                       Text="Nhập mã gồm 6 chữ số được gửi đến" 
                                       FontSize="15" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       Margin="0,0,0,4"/>

                            <TextBlock x:Name="lblMaskedEmail" 
                                       Text="m***@nhahang.vn" 
                                       FontSize="15" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Mã xác minh" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,8"/>

                            <!-- 6 Separate OTP Digit Input Boxes -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtOtp1" Grid.Column="0" Style="{StaticResource OtpDigitBoxStyle}" TextChanged="OtpDigit_TextChanged" PreviewKeyDown="OtpDigit_PreviewKeyDown"/>
                                <TextBox x:Name="txtOtp2" Grid.Column="2" Style="{StaticResource OtpDigitBoxStyle}" TextChanged="OtpDigit_TextChanged" PreviewKeyDown="OtpDigit_PreviewKeyDown"/>
                                <TextBox x:Name="txtOtp3" Grid.Column="4" Style="{StaticResource OtpDigitBoxStyle}" TextChanged="OtpDigit_TextChanged" PreviewKeyDown="OtpDigit_PreviewKeyDown"/>
                                <TextBox x:Name="txtOtp4" Grid.Column="6" Style="{StaticResource OtpDigitBoxStyle}" TextChanged="OtpDigit_TextChanged" PreviewKeyDown="OtpDigit_PreviewKeyDown"/>
                                <TextBox x:Name="txtOtp5" Grid.Column="8" Style="{StaticResource OtpDigitBoxStyle}" TextChanged="OtpDigit_TextChanged" PreviewKeyDown="OtpDigit_PreviewKeyDown"/>
                                <TextBox x:Name="txtOtp6" Grid.Column="10" Style="{StaticResource OtpDigitBoxStyle}" TextChanged="OtpDigit_TextChanged" PreviewKeyDown="OtpDigit_PreviewKeyDown"/>
                            </Grid>

                            <!-- Live Feedback Message (Error / Warning / Notice) -->
                            <TextBlock x:Name="lblOtpNotification" 
                                       Text="Mã chỉ có hiệu lực trong 60 giây." 
                                       FontSize="13" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,4"/>

                            <!-- Timer Countdown -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock x:Name="lblCountdownPrompt" Text="Thời gian còn lại: " FontSize="13" Foreground="{StaticResource ColorTextSecondary}"/>
                                <TextBlock x:Name="lblCountdown" Text="60 giây" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ColorAccent}"/>
                            </StackPanel>

                            <!-- Verify Button (Enabled when all 6 digits entered) -->
                            <Button x:Name="btnVerifyOtp" 
                                    Content="Xác minh" 
                                    IsEnabled="False" 
                                    Style="{StaticResource LoginPillButtonStyle}" 
                                    Margin="0,0,0,16" 
                                    Click="BtnVerifyOtp_Click"/>

                            <!-- Resend OTP Trigger (User Click Required - NOT AUTO) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Name="lblResendPrefix" Text="Chưa nhận được mã? " FontSize="13" Foreground="{StaticResource ColorTextSecondary}"/>
                                <TextBlock x:Name="btnResendOtp" 
                                           Text="Gửi lại mã" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource ColorAccent}" 
                                           Cursor="Hand" 
                                           MouseLeftButtonUp="BtnResendOtp_Click"/>
                            </StackPanel>

                            <!-- Change Email Link (Return to Step 1) -->
                            <TextBlock Text="Thay đổi thư điện tử" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorAccent}" 
                                       HorizontalAlignment="Center" 
                                       Cursor="Hand" 
                                       Margin="0,0,0,16"
                                       MouseLeftButtonUp="LinkChangeEmail_Click"/>

                            <TextBlock Text="Bước 2 / 3 · Xác thực OTP" 
                                       FontSize="12" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- ================= STEP 3: ĐẶT LẠI MẬT KHẨU (Frames 13 - 18) ================= -->
                        <StackPanel x:Name="pnlStep3" Visibility="Collapsed">
                            <TextBlock Text="Đặt lại mật khẩu" 
                                       FontSize="30" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Tạo mật khẩu mới để bảo vệ tài khoản.&#x0a;Không sử dụng lại mật khẩu trước đây." 
                                       FontSize="15" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       LineHeight="22" 
                                       Margin="0,0,0,16"/>

                            <!-- New Password Field with Eye Toggle -->
                            <TextBlock Text="Mật khẩu mới" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,10">
                                <PasswordBox x:Name="txtNewPassword" 
                                             Style="{StaticResource ModernRoundedPasswordBoxStyle}" 
                                             PasswordChanged="PasswordInputs_Changed"/>
                                <TextBox x:Name="txtNewPasswordVisible" 
                                         Style="{StaticResource ModernRoundedTextBoxStyle}" 
                                         Visibility="Collapsed" 
                                         TextChanged="PasswordInputs_Changed"/>
                                <Button x:Name="btnToggleNewPassword" 
                                        Content="👁️" 
                                        FontSize="14" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,16,0" 
                                        Click="BtnToggleNewPassword_Click"/>
                            </Grid>

                            <!-- Password Strength Indicator (4 Bars: Figma Mức độ mạnh 1 - 4) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="barStrength1" Grid.Column="0" Height="4" CornerRadius="2" Background="{StaticResource ColorBorder}"/>
                                <Border x:Name="barStrength2" Grid.Column="2" Height="4" CornerRadius="2" Background="{StaticResource ColorBorder}"/>
                                <Border x:Name="barStrength3" Grid.Column="4" Height="4" CornerRadius="2" Background="{StaticResource ColorBorder}"/>
                                <Border x:Name="barStrength4" Grid.Column="6" Height="4" CornerRadius="2" Background="{StaticResource ColorBorder}"/>
                            </Grid>

                            <TextBlock x:Name="lblStrengthText" 
                                       Text="Độ mạnh mật khẩu" 
                                       FontSize="12" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="Ít nhất 8 ký tự; có chữ hoa, chữ thường, số và ký tự đặc biệt." 
                                       FontSize="11" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       Margin="0,0,0,12"/>

                            <!-- Confirm Password Field with Eye Toggle -->
                            <TextBlock Text="Xác nhận mật khẩu" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <PasswordBox x:Name="txtConfirmPassword" 
                                             Style="{StaticResource ModernRoundedPasswordBoxStyle}" 
                                             PasswordChanged="PasswordInputs_Changed"/>
                                <TextBox x:Name="txtConfirmPasswordVisible" 
                                         Style="{StaticResource ModernRoundedTextBoxStyle}" 
                                         Visibility="Collapsed" 
                                         TextChanged="PasswordInputs_Changed"/>
                                <Button x:Name="btnToggleConfirmPassword" 
                                        Content="👁️" 
                                        FontSize="14" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,16,0" 
                                        Click="BtnToggleConfirmPassword_Click"/>
                            </Grid>

                            <TextBlock x:Name="lblPasswordValidation" 
                                       Text="Nhập lại mật khẩu mới để xác nhận." 
                                       FontSize="12" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       Margin="0,0,0,16"/>

                            <!-- Submit Button -->
                            <Button x:Name="btnUpdatePassword" 
                                    Content="Cập nhật mật khẩu" 
                                    IsEnabled="False" 
                                    Style="{StaticResource LoginPillButtonStyle}" 
                                    Margin="0,0,0,16" 
                                    Click="BtnUpdatePassword_Click"/>

                            <TextBlock Text="Bước 2 / 3 · Thiết lập mật khẩu mới" 
                                       FontSize="12" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- ================= STEP 4: KHÔI PHỤC THÀNH CÔNG (Frame 19) ================= -->
                        <StackPanel x:Name="pnlStep4" Visibility="Collapsed" HorizontalAlignment="Center">
                            <!-- Success Checkmark Badge (64x64) -->
                            <Border Background="{StaticResource ColorAppBg}" 
                                    CornerRadius="32" 
                                    Width="64" 
                                    Height="64" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,16,0,24">
                                <TextBlock Text="✔️" 
                                           FontSize="26" 
                                           Foreground="{StaticResource ColorSuccessDark}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Mật khẩu đã cập nhật" 
                                       FontSize="30" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorTextDark}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Bạn đã đặt lại mật khẩu thành công.&#x0a;Hãy đăng nhập bằng mật khẩu mới để tiếp tục." 
                                       FontSize="15" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       TextAlignment="Center" 
                                       LineHeight="24" 
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="Tài khoản của bạn đã sẵn sàng." 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource ColorSuccessDark}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,32"/>

                            <Button Content="Quay lại đăng nhập" 
                                    Style="{StaticResource LoginPillButtonStyle}" 
                                    Width="536" 
                                    Margin="0,0,0,36" 
                                    Click="LinkBackToLogin_Click"/>

                            <TextBlock Text="Bước 3 / 3 · Hoàn tất khôi phục" 
                                       FontSize="12" 
                                       Foreground="{StaticResource ColorTextSecondary}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= FOOTER COPYRIGHT ================= -->
            <TextBlock Grid.Row="2" 
                       Text="© 2026 Nhà hàng Gourmet" 
                       FontSize="12" 
                       Foreground="#475569" 
                       HorizontalAlignment="Center" 
                       Margin="0,24,0,16"/>
        </Grid>
    </ScrollViewer>
</UserControl>