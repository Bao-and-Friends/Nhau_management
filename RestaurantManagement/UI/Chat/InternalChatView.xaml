<UserControl x:Class="RestaurantClient.UI.Chat.InternalChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Online staff list -->
        <Border Grid.Column="0" Style="{StaticResource CardContainerStyle}" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Nhân Viên Trực Tuyến" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource ColorAppBg}" CornerRadius="8" Padding="10" Margin="0,0,0,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ColorTableOccupied}" Margin="0,0,8,0"/>
                                <TextBlock Text="Trần Trí Bảo (Bếp)" FontWeight="SemiBold" Foreground="{StaticResource ColorTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ColorAppBg}" CornerRadius="8" Padding="10" Margin="0,0,0,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ColorTableOccupied}" Margin="0,0,8,0"/>
                                <TextBlock Text="Lê Dương Bảo (Thu Ngân)" FontWeight="SemiBold" Foreground="{StaticResource ColorTextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource ColorAppBg}" CornerRadius="8" Padding="10" Margin="0,0,0,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource ColorTableOccupied}" Margin="0,0,8,0"/>
                                <TextBlock Text="Phạm Thị Mai (Phục Vụ)" FontWeight="SemiBold" Foreground="{StaticResource ColorTextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Right: Message history & Chat input -->
        <Border Grid.Column="1" Style="{StaticResource CardContainerStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Kênh Trao Đổi Nội Bộ Nhà Hàng" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}"/>
                    <TextBlock Text="● 4 người đang hoạt động" FontSize="12" Foreground="{StaticResource ColorTableOccupied}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Chat history -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border HorizontalAlignment="Left" Background="{StaticResource ColorAppBg}" CornerRadius="12" Padding="12,8" Margin="0,0,0,10" MaxWidth="500">
                            <StackPanel>
                                <TextBlock Text="Trí Bảo (Bếp) - 20:05" FontSize="11" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,2"/>
                                <TextBlock Text="Bàn VIP01 xong món Bò Fuji rồi nhé phục vụ ơi!" Foreground="{StaticResource ColorTextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border HorizontalAlignment="Right" Background="{StaticResource ColorAccent}" CornerRadius="12" Padding="12,8" Margin="0,0,0,10" MaxWidth="500">
                            <StackPanel>
                                <TextBlock Text="Tôi (Quản lý) - 20:06" FontSize="11" Foreground="#93C5FD" Margin="0,0,0,2"/>
                                <TextBlock Text="Đã nhận tin, phục vụ Mai bưng ra cho khách ngay nhé." Foreground="{StaticResource ColorTextWhite}"/>
                            </StackPanel>
                        </Border>

                        <Border HorizontalAlignment="Left" Background="{StaticResource ColorAppBg}" CornerRadius="12" Padding="12,8" Margin="0,0,0,10" MaxWidth="500">
                            <StackPanel>
                                <TextBlock Text="Phạm Thị Mai (Phục Vụ) - 20:07" FontSize="11" Foreground="{StaticResource ColorTextSecondary}" Margin="0,0,0,2"/>
                                <TextBlock Text="Dạ em đang mang ra bàn VIP01 rồi ạ." Foreground="{StaticResource ColorTextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Chat input bar -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="Nhập tin nhắn trao đổi..." Height="40" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Gửi 📤" Style="{StaticResource PrimaryButtonStyle}" Height="40"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
