<UserControl x:Class="RestaurantClient.UI.Account.UserProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Profile Info Card -->
        <Border Grid.Column="0" Style="{StaticResource CardContainerStyle}" Margin="0,0,16,0">
            <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                <Border Width="90" Height="90" CornerRadius="45" Background="{StaticResource ColorAccent}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Nguyễn Quốc Huy" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource ColorTextPrimary}"/>
                <TextBlock Text="Vai trò: Quản Lý Nhà Hàng" FontSize="14" Foreground="{StaticResource ColorAccent}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <StackPanel Width="320" HorizontalAlignment="Center">
                    <TextBlock Text="Mã nhân viên: NV01" Margin="0,4" Foreground="{StaticResource ColorTextSecondary}"/>
                    <TextBlock Text="Số điện thoại: 0901 234 567" Margin="0,4" Foreground="{StaticResource ColorTextSecondary}"/>
                    <TextBlock Text="Email: quochuy@thegourmet.vn" Margin="0,4" Foreground="{StaticResource ColorTextSecondary}"/>
                    <TextBlock Text="Ca trực: Ca Sáng (08:00 - 16:30)" Margin="0,4" Foreground="{StaticResource ColorTextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right: Change Password & Update form -->
        <Border Grid.Column="1" Style="{StaticResource CardContainerStyle}">
            <StackPanel Margin="16">
                <TextBlock Text="Đổi Mật Khẩu Đăng Nhập" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}" Margin="0,0,0,16"/>

                <TextBlock Text="Mật khẩu hiện tại:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource ColorTextPrimary}"/>
                <PasswordBox Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="Mật khẩu mới:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource ColorTextPrimary}"/>
                <PasswordBox Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="Xác nhận mật khẩu mới:" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource ColorTextPrimary}"/>
                <PasswordBox Style="{StaticResource ModernPasswordBoxStyle}" Margin="0,0,0,24"/>

                <Button Content="💾 Lưu Mật Khẩu Mới" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Width="200" Height="42"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
