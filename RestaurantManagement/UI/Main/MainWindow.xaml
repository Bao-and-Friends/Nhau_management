<Window x:Class="RestaurantClient.UI.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Gourmet Restaurant - Quản Lý Nhà Hàng" 
        Height="900" Width="1440"
        MinHeight="768" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter"
        Background="{StaticResource ColorAppBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER (Figma node 9:23) ================= -->
        <Border Grid.Row="0" Background="{StaticResource ColorPrimary}" Padding="24,0">
            <Grid>
                <!-- Brand Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="🍽️  THE GOURMET RESTAURANT" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource ColorTextWhite}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Real-time Clock (Subtle Status) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🕒 " FontSize="13" Foreground="{StaticResource ColorTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblClock" Text="15/11/2026 12:00:00" FontSize="13" FontWeight="Medium" Foreground="{StaticResource ColorTextSidebarInactive}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Current Staff Profile & Logout (Figma node 9:22) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="lblStaffProfile" 
                               Text="👤  Quốc Huy (Quản lý)" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource ColorAccentLight}" 
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <Button Content="Đăng Xuất 🚪" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Background="#334155" 
                            FontSize="12" 
                            Padding="12,6" 
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR MENU (Figma node 9:24) -->
            <Border Grid.Column="0" Background="{StaticResource ColorSidebarBg}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="sidebarPanel" Margin="12,16,12,16">
                        <Button x:Name="btnNavDashboard" Content="🏠  Tổng Quan" Style="{StaticResource SidebarButtonStyle}" Tag="Active" Margin="0,0,0,4" Click="Nav_Dashboard_Click"/>
                        <Button x:Name="btnNavTableMap" Content="🪑  Sơ Đồ Bàn Ăn" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_TableMap_Click"/>
                        <Button x:Name="btnNavServing" Content="📝  Phục Vụ / Gọi Món" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_Serving_Click"/>
                        <Button x:Name="btnNavCashier" Content="💳  Thu Ngân &amp; Bill" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_Cashier_Click"/>
                        <Button x:Name="btnNavFood" Content="🍔  Thực Đơn Món Ăn" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_Food_Click"/>
                        <Button x:Name="btnNavStaff" Content="👥  Quản Lý Nhân Sự" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_Staff_Click"/>
                        <Button x:Name="btnNavRevenue" Content="📊  Báo Cáo Doanh Thu" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_Revenue_Click"/>
                        <Button x:Name="btnNavInventory" Content="📦  Kho Hàng" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_Inventory_Click"/>
                        <Button x:Name="btnNavChat" Content="💬  Chat Nội Bộ" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,4" Click="Nav_Chat_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTRAL WORKSPACE (Figma node 9:66) -->
            <ContentControl Grid.Column="1" x:Name="mainContent" Margin="0" Background="{StaticResource ColorAppBg}"/>
        </Grid>
    </Grid>
</Window>