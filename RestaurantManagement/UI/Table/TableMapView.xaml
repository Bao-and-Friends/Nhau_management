<UserControl x:Class="RestaurantClient.UI.Table.TableMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Sơ Đồ Bàn Ăn" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ColorTextPrimary}"/>
                <TextBlock Text="Trực quan hóa trạng thái và bố trí bàn trong nhà hàng" FontSize="14" Foreground="{StaticResource ColorTextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Content="🔄 Làm Mới Dữ Liệu" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="BtnRefresh_Click"/>
        </Grid>

        <!-- Status Legend Filter -->
        <Border Grid.Row="1" Style="{StaticResource CardContainerStyle}" Margin="0,0,0,20" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Chú thích trạng thái:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource ColorTextPrimary}"/>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource ColorTableEmpty}" Margin="0,0,6,0"/>
                    <TextBlock Text="Trống (Sẵn sàng)" VerticalAlignment="Center" Foreground="{StaticResource ColorTextSecondary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource ColorTableOccupied}" Margin="0,0,6,0"/>
                    <TextBlock Text="Có Khách (Đang ăn)" VerticalAlignment="Center" Foreground="{StaticResource ColorTextSecondary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource ColorTableReserved}" Margin="0,0,6,0"/>
                    <TextBlock Text="Đã Đặt Trước" VerticalAlignment="Center" Foreground="{StaticResource ColorTextSecondary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource ColorTableWaiting}" Margin="0,0,6,0"/>
                    <TextBlock Text="Chờ Dọn Dẹp" VerticalAlignment="Center" Foreground="{StaticResource ColorTextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tables ItemsControl Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icTables">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Height="150" Margin="10" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource ColorBorder}" Background="{StaticResource ColorCardBg}" Cursor="Hand">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table Code & Capacity -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding MaBan}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ColorTextPrimary}"/>
                                    <TextBlock Text="{Binding SucChua, StringFormat='{}{0} Chỗ'}" FontSize="12" Foreground="{StaticResource ColorTextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Table Display Name -->
                                <TextBlock Grid.Row="1" Text="{Binding TenBan}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ColorTextPrimary}"/>

                                <!-- Status Badge -->
                                <Border Grid.Row="2" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TenTrangThaiVN}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
