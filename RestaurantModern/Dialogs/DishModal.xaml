<Window x:Class="RestaurantModern.Dialogs.DishModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm món ăn mới"
        Width="680" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.15" Color="#14243D"/>
        </Border.Effect>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <!-- 1. Header (Figma 52:122) -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- 2. Form Fields (Figma 52:127) -->
                <RowDefinition Height="*"/>
                <!-- 3. Bottom Actions -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" 
                        Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold" 
                        Foreground="{StaticResource Brush.Text.Muted}" Cursor="Hand" Width="32" Height="32"/>
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="Thêm món ăn mới" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                    <TextBlock Text="Bổ sung món ăn hoặc đồ uống vào thực đơn nhà hàng." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <Separator Grid.Row="1" Background="{StaticResource Brush.Divider}" Margin="0,16"/>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Tên món -->
                    <TextBlock Text="Tên món ăn *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtTenMon" Height="44" Margin="0,0,0,14" ToolTip="Ví dụ: Lẩu Thái Hải Sản"/>

                    <!-- Danh mục & Đơn vị tính -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Danh mục *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbDanhMuc" Height="44" SelectedIndex="0">
                                <ComboBoxItem Content="Món chính"/>
                                <ComboBoxItem Content="Lẩu &amp; Nướng"/>
                                <ComboBoxItem Content="Hải sản"/>
                                <ComboBoxItem Content="Khai vị"/>
                                <ComboBoxItem Content="Đồ uống"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Đơn vị tính *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtDonViTinh" Text="Đĩa" Height="44"/>
                        </StackPanel>
                    </Grid>

                    <!-- Đơn giá & Trạng thái -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Đơn giá (VNĐ) *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtDonGia" Text="150000" Height="44"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tình trạng phục vụ *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbTrangThai" Height="44" SelectedIndex="0">
                                <ComboBoxItem Content="Đang phục vụ"/>
                                <ComboBoxItem Content="Hết món / Ngưng bán"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Ghi chú / Mô tả -->
                    <TextBlock Text="Mô tả món ăn" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtMoTa" Height="44" ToolTip="Thành phần, độ cay, lưu ý chế biến..."/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Hủy bỏ" Click="Close_Click" Style="{StaticResource SecondaryButton}" Width="110" Height="42" Margin="0,0,12,0"/>
                <Button Content="Lưu món ăn" Click="Save_Click" Style="{StaticResource PrimaryButton}" Width="140" Height="42"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
