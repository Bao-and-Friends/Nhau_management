<Window x:Class="RestaurantModern.Dialogs.AddTableModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm bàn mới"
        Width="520" Height="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#14243D"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- 1. Header (Figma 52:101) -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- 2. Form Body -->
                <RowDefinition Height="*"/>
                <!-- 3. Bottom Actions -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" 
                        Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold" 
                        Foreground="{StaticResource Brush.Text.Muted}" Cursor="Hand" Width="32" Height="32"/>
                <StackPanel>
                    <TextBlock Text="Thêm bàn ăn mới" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                    <TextBlock Text="Khởi tạo vị trí bàn mới trong sơ đồ phục vụ của nhà hàng." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <Separator Grid.Row="1" Background="{StaticResource Brush.Divider}" Margin="0,14"/>

            <!-- 2. Form Body -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Tên bàn ăn *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtTenBan" Text="Bàn 11" Height="44" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sức chứa (chỗ ngồi) *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbSucChua" Height="44" SelectedIndex="1">
                            <ComboBoxItem Content="2 chỗ"/>
                            <ComboBoxItem Content="4 chỗ"/>
                            <ComboBoxItem Content="6 chỗ"/>
                            <ComboBoxItem Content="8 chỗ"/>
                            <ComboBoxItem Content="10 chỗ (VIP)"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Khu vực bố trí *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbKhuVuc" Height="44" SelectedIndex="0">
                            <ComboBoxItem Content="Tầng 1 (Sảnh chính)"/>
                            <ComboBoxItem Content="Tầng 2 (Máy lạnh)"/>
                            <ComboBoxItem Content="Sân vườn"/>
                            <ComboBoxItem Content="Phòng VIP"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 3. Bottom Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy bỏ" Click="Close_Click" Style="{StaticResource SecondaryButton}" Width="100" Height="42" Margin="0,0,10,0"/>
                <Button Content="Tạo bàn mới" Click="Save_Click" Style="{StaticResource PrimaryButton}" Height="42" Padding="18,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
