<Window x:Class="RestaurantModern.Dialogs.TableActionModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuyển bàn &amp; Gộp bàn"
        Width="580" Height="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" CornerRadius="18" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.16" Color="#14243D"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- 1. Header (Figma 52:167) -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- 2. Tabs (Figma 52:172) -->
                <RowDefinition Height="Auto"/>
                <!-- 3. Form Body (Figma 52:177) -->
                <RowDefinition Height="*"/>
                <!-- 4. Bottom Actions -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click" 
                        Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold" 
                        Foreground="{StaticResource Brush.Text.Muted}" Cursor="Hand" Width="32" Height="32"/>
                <StackPanel>
                    <TextBlock Text="Chuyển bàn &amp; Gộp bàn" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Phiên phục vụ hiện tại: Bàn 02 • 6 khách" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <Separator Grid.Row="1" Background="{StaticResource Brush.Divider}" Margin="0,14"/>

            <!-- 2. Tabs -->
            <Border Grid.Row="2" Background="{StaticResource Brush.Surface.Subtle}" CornerRadius="9" Padding="4" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnTabTransfer" Grid.Column="0" Content="Chuyển bàn" Click="TabTransfer_Click" 
                            Style="{StaticResource PrimaryButton}" Height="38"/>
                    <Button x:Name="BtnTabMerge" Grid.Column="1" Content="Gộp bàn" Click="TabMerge_Click" 
                            Style="{StaticResource SecondaryButton}" Height="38" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- 3. Form Body -->
            <StackPanel Grid.Row="3">
                <TextBlock x:Name="LblTargetTable" Text="Chọn bàn đích đến *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                <ComboBox x:Name="CmbTargetTable" Height="44" SelectedIndex="0" Margin="0,0,0,14">
                    <ComboBoxItem Content="Bàn 01 · Trống · 4 chỗ (Tầng 1)"/>
                    <ComboBoxItem Content="Bàn 03 · Trống · 6 chỗ (Tầng 1)"/>
                    <ComboBoxItem Content="Bàn 05 · Trống · 6 chỗ (Tầng 2)"/>
                    <ComboBoxItem Content="Bàn 06 · Trống · 8 chỗ (Tầng 2)"/>
                    <ComboBoxItem Content="Bàn VIP 01 · Trống · 10 chỗ (VIP)"/>
                </ComboBox>

                <TextBlock x:Name="LblReason" Text="Lý do chuyển bàn" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtReason" Text="Khách muốn đổi vị trí thoáng hơn" Height="44" ToolTip="Nhập lý do chuyển hoặc ghi chú..."/>
            </StackPanel>

            <!-- 4. Bottom Actions -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Hủy bỏ" Click="Close_Click" Style="{StaticResource SecondaryButton}" Width="100" Height="42" Margin="0,0,10,0"/>
                <Button x:Name="BtnSubmit" Content="Xác nhận chuyển bàn" Click="Submit_Click" Style="{StaticResource PrimaryButton}" Height="42" Padding="18,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
