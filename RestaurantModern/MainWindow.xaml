<Window x:Class="RestaurantModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RestaurantModern.ViewModels"
        xmlns:views="clr-namespace:RestaurantModern.Views"
        Title="Hệ Thống Quản Lý Nhà Hàng" 
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource Brush.App.Background}">

    <Window.Resources>
        <!-- MVVM ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TableManagementViewModel}">
            <views:TableManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TableDetailViewModel}">
            <views:TableDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentViewModel}">
            <views:PaymentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceViewModel}">
            <views:InvoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <views:StaffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftsViewModel}">
            <views:ShiftsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PromoViewModel}">
            <views:PromoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RevenueStatsViewModel}">
            <views:RevenueStatsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
            <views:ProfileView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: Fixed 260px (Khớp Figma 6:3) -->
            <ColumnDefinition Width="260"/>
            <!-- Content Area: Responsive Star Width (Khớp Figma 6:33 và mở rộng toàn màn hình) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT SIDEBAR (Khớp Figma 6:3: width=260, bg=#14243D) -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar.Background}" Padding="20">
            <DockPanel LastChildFill="True">
                <!-- Top Brand Header (Figma 6:4 - 6:5) -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="QUẢN LÝ NHÀ HÀNG" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="HỆ THỐNG NỘI BỘ" Foreground="{StaticResource Brush.Text.NavSub}" FontSize="10" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Bottom User Profile & Logout -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Border Background="#1D2E48" CornerRadius="10" Padding="12,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentStaffName}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding CurrentStaffRole}" Foreground="{StaticResource Brush.Text.NavSub}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🚪 Đăng xuất khỏi hệ thống" Command="{Binding LogoutCommand}" Style="{StaticResource LogoutButton}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Navigation Menu List (Khớp Figma 6:7 - 6:32) -->
                <ListBox ItemsSource="{Binding NavItems}" 
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SidebarNavItem}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding Icon}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 2. MAIN CONTENT AREA (Khớp Figma 6:33: padding=30, bg=#F5F7FB) -->
        <Border Grid.Column="1" Background="{StaticResource Brush.App.Background}" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header (Figma 6:34: QUẢN LÝ NHÀ HÀNG + Title 29px + Subtitle 12px) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Dynamic Page Surface -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header (Khớp Figma 6:35) -->
                <DockPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="QUẢN LÝ NHÀ HÀNG" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActivePageTitle}" Foreground="{StaticResource Brush.Text.Dark}" FontWeight="Bold" FontSize="28"/>
                        <TextBlock Text="{Binding ActivePageSubtitle}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Top Right Quick Info Badge (Khớp 100% Figma 6:35) -->
                    <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mã NV: " Foreground="{StaticResource Brush.Text.Muted}" FontSize="12.5"/>
                            <TextBlock Text="{Binding CurrentStaffCode}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" FontSize="12.5" Margin="0,0,12,0"/>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Empty}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Trực tuyến" Foreground="{StaticResource Brush.Status.Empty}" FontWeight="SemiBold" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Dynamic View Content (MVVM ContentControl) -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</Window>
