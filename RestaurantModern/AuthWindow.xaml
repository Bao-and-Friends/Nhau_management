<Window x:Class="RestaurantModern.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Nhà Hàng - Xác thực" 
        Height="880" Width="1380" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource Brush.Auth.Background}">

    <Grid>
        <!-- Center Auth Shell Container with CornerRadius=26 (Khớp Figma 5:12) -->
        <Border Background="{StaticResource Brush.Auth.Shell}" 
                CornerRadius="26" 
                MaxWidth="1200" MaxHeight="750" 
                Margin="30"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" Direction="-90" RenderingBias="Quality" ShadowDepth="4" Opacity="0.14" Color="#102038"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left Brand Column (Figma 5:13: width=480, bg=#FAFCFF) -->
                    <ColumnDefinition Width="480"/>
                    <!-- Right Form Column (Figma 5:17: width=*, bg=White) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. LEFT COLUMN: Auth / Brand (Figma 5:13) -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Auth.Brand}" CornerRadius="26,0,0,26" Padding="40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Logo Icon (CornerRadius=28, Khớp Figma 5:14) -->
                        <Border Background="{StaticResource Brush.Auth.LogoBg}" CornerRadius="28" Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,28">
                            <TextBlock Text="🍽" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Brand Title (Khớp Figma 5:16) -->
                        <TextBlock Text="Quản Lý" FontSize="42" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nhà Hàng" FontSize="42" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" Margin="0,-6,0,16"/>

                        <TextBlock Text="Hệ thống hỗ trợ quản lý bàn, gọi món và thanh toán thông minh" 
                                   Foreground="{StaticResource Brush.Text.Secondary}" 
                                   FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                    </StackPanel>
                </Border>

                <!-- 2. RIGHT COLUMN: Auth / Form Surface (Figma 5:17) -->
                <Border Grid.Column="1" Background="{StaticResource Brush.Auth.Shell}" CornerRadius="0,26,26,0" Padding="50">
                    <Grid VerticalAlignment="Center" MaxWidth="440" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Feedback Alert Banner (FIX: Separate row, NEVER overlaps form elements) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Active Form Step -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- FEEDBACK ALERT BANNER (Fixes text overlay bug) -->
                        <Border Grid.Row="0" x:Name="AlertBanner" 
                                Background="{Binding AlertBackground}" 
                                BorderBrush="{Binding AlertBorder}" 
                                BorderThickness="1" 
                                CornerRadius="9" 
                                Padding="14,10" 
                                Margin="0,0,0,16" 
                                Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Text="{Binding AlertIcon}" FontWeight="Bold" FontSize="14" Foreground="{Binding AlertForeground}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{Binding AlertForeground}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- FORM PANELS CONTAINER (Row 1) -->
                        <Grid Grid.Row="1">
                            <!-- 1. LOGIN STEP (Figma 5:11) -->
                            <StackPanel x:Name="LoginPanel" Visibility="Visible">
                                <TextBlock Text="Đăng nhập" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Sử dụng tài khoản nhân viên đã được cấp bởi quản lý." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13.5" Margin="0,6,0,24"/>

                                <TextBlock Text="Tên đăng nhập" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="46" Margin="0,0,0,14" ToolTip="Ví dụ: QL01, TN01, NV01"/>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Mật khẩu" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}"/>
                                    <Button Content="Quên mật khẩu?" Click="GoForgot_Click" 
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Accent.Secondary}" 
                                            FontWeight="Bold" FontSize="12.5" Cursor="Hand" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <PasswordBox x:Name="TxtPassword" Height="46" Margin="0,0,0,20"/>

                                <Button Content="Đăng nhập" Click="LoginButton_Click" Style="{StaticResource PrimaryButton}" Height="48" Margin="0,0,0,12"/>

                                <TextBlock Text="* Tài khoản nhân viên được tạo và phân quyền bởi Quản lý nhà hàng." 
                                           Foreground="{StaticResource Brush.Text.Muted}" FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>

                            <!-- 2. FORGOT PASSWORD STEP (Figma 5:64) -->
                            <StackPanel x:Name="ForgotPanel" Visibility="Collapsed">
                                <TextBlock Text="Quên mật khẩu" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Nhập tên đăng nhập để nhận mã xác thực OTP gửi về email." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,6,0,20"/>

                                <TextBlock Text="Tên đăng nhập" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="46" Margin="0,0,0,20" ToolTip="Tên tài khoản của bạn"/>

                                <Button Content="Gửi mã OTP qua Email" Click="SendOtp_Click" Style="{StaticResource PrimaryButton}" Height="48" Margin="0,0,0,12"/>
                                <Button Content="← Quay lại đăng nhập" Click="GoLogin_Click" Style="{StaticResource SecondaryButton}" Height="42"/>
                            </StackPanel>

                            <!-- 3. OTP STEP (Figma 5:82) -->
                            <StackPanel x:Name="OtpPanel" Visibility="Collapsed">
                                <TextBlock Text="Nhập mã OTP" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Vui lòng nhập mã OTP 6 chữ số đã được gửi về email." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,6,0,20"/>

                                <TextBlock Text="Mã OTP xác thực" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}" Height="46" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>

                                <Button Content="Xác nhận mã OTP" Click="VerifyOtp_Click" Style="{StaticResource PrimaryButton}" Height="48" Margin="0,0,0,12"/>
                                <Button Content="← Quay lại đăng nhập" Click="GoLogin_Click" Style="{StaticResource SecondaryButton}" Height="42"/>
                            </StackPanel>

                            <!-- 4. RESET PASSWORD STEP (Figma 5:114) -->
                            <StackPanel x:Name="ResetPanel" Visibility="Collapsed">
                                <TextBlock Text="Đặt lại mật khẩu" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Thiết lập mật khẩu mới cho tài khoản của bạn (tối thiểu 6 ký tự)." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,6,0,20"/>

                                <TextBlock Text="Mật khẩu mới" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="46" Margin="0,0,0,12"/>

                                <TextBlock Text="Xác nhận mật khẩu mới" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Height="46" Margin="0,0,0,20"/>

                                <Button Content="Hoàn tất đặt lại mật khẩu" Click="ResetPassword_Click" Style="{StaticResource PrimaryButton}" Height="48" Margin="0,0,0,12"/>
                                <Button Content="← Quay lại đăng nhập" Click="GoLogin_Click" Style="{StaticResource SecondaryButton}" Height="42"/>
                            </StackPanel>

                            <!-- 5. SUCCESS STEP (Khớp Figma 52:3 Frame / Đổi mật khẩu thành công) -->
                            <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Border Background="#DCFCE7" CornerRadius="38" Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,22">
                                    <TextBlock Text="✓" FontSize="38" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Đổi mật khẩu thành công!" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Text="Mật khẩu của bạn đã được cập nhật thành công. Vui lòng đăng nhập lại với mật khẩu mới." 
                                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,26" MaxWidth="360"/>

                                <Button Content="Đăng nhập ngay" Click="GoLogin_Click" Style="{StaticResource PrimaryButton}" Height="48" Width="360"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
