<UserControl x:Class="RestaurantModern.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Staff Cards Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Controls Bar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <!-- Button: + Thêm nhân viên & Cấp tài khoản -->
                <Button DockPanel.Dock="Right" Content="+ Thêm nhân viên &amp; Cấp tài khoản" 
                        Command="{Binding OpenAddModalCommand}" 
                        Style="{StaticResource PrimaryButton}" Height="40" Padding="18,4"/>

                <TextBox DockPanel.Dock="Right" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="260" Height="40" VerticalContentAlignment="Center" Margin="0,0,16,0"
                         ToolTip="Tìm theo tên hoặc mã nhân viên..."/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tất cả" Command="{Binding FilterCommand}" CommandParameter="Tất cả" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,6,0"/>
                    <Button Content="Quản lý" Command="{Binding FilterCommand}" CommandParameter="Quản lý" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,6,0"/>
                    <Button Content="Thu ngân" Command="{Binding FilterCommand}" CommandParameter="Thu ngân" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,6,0"/>
                    <Button Content="Phục vụ" Command="{Binding FilterCommand}" CommandParameter="Phục vụ" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,6,0"/>
                    <Button Content="Bếp" Command="{Binding FilterCommand}" CommandParameter="Bếp trưởng" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Staff Cards Grid (WrapPanel) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredStaff}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="265" Height="195" Margin="0,0,16,16" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource Brush.Accent.SecondaryLight}" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{Binding VaiTro}" Foreground="{StaticResource Brush.Accent.Secondary}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="{Binding MaNV}" Foreground="{StaticResource Brush.Text.Muted}" FontWeight="Bold" FontSize="13"/>
                                </DockPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding HoTen}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Brush.Text.Dark}"/>
                                    <TextBlock Text="{Binding SoDienThoai, StringFormat='📞 {0}'}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Email, StringFormat='✉ {0}'}" Foreground="{StaticResource Brush.Text.Muted}" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>

                                <DockPanel Grid.Row="2">
                                    <Border Background="{StaticResource Brush.Status.EmptyBg}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TrangThai}" Foreground="{StaticResource Brush.Status.Empty}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 3. Modal / Thêm nhân viên và tài khoản (Khớp chuẩn Figma 8:78) -->
        <Grid Grid.RowSpan="2" Background="#90000000" Visibility="{Binding ShowAddModal, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="640" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.25" Color="#102038"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseAddModalCommand}" 
                                Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold" 
                                Foreground="{StaticResource Brush.Text.Muted}" Cursor="Hand" Width="32" Height="32"/>
                        <StackPanel>
                            <TextBlock Text="Thêm nhân viên &amp; Cấp tài khoản" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                            <TextBlock Text="Thông tin sẽ được mã hóa và lưu trực tiếp vào cơ sở dữ liệu." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Grid.Row="1" Background="{StaticResource Brush.Divider}" Margin="0,14"/>

                    <!-- Form Body -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Họ tên & Tên đăng nhập -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Họ và tên nhân viên *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" Height="44" ToolTip="Ví dụ: Nguyễn Văn An"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tên đăng nhập (Username) *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Height="44" ToolTip="Ví dụ: an_nv"/>
                                </StackPanel>
                            </Grid>

                            <!-- Mật khẩu khởi tạo & Vai trò -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mật khẩu khởi tạo *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="44" ToolTip="Tối thiểu 6 ký tự"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Vai trò phân quyền *" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <ComboBox SelectedValue="{Binding NewRole, Mode=TwoWay}" SelectedValuePath="Content" Height="44">
                                        <ComboBoxItem Content="Phục vụ" IsSelected="True"/>
                                        <ComboBoxItem Content="Thu ngân"/>
                                        <ComboBoxItem Content="Quản lý"/>
                                        <ComboBoxItem Content="Bếp trưởng"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Giới tính & Số điện thoại -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Giới tính" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <ComboBox SelectedValue="{Binding NewGender, Mode=TwoWay}" SelectedValuePath="Content" Height="44">
                                        <ComboBoxItem Content="Nam" IsSelected="True"/>
                                        <ComboBoxItem Content="Nữ"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số điện thoại" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" Height="44" ToolTip="09xxxxxxxx"/>
                                </StackPanel>
                            </Grid>

                            <!-- Email & Địa chỉ -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Email liên hệ" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Height="44" ToolTip="email@nhau.vn"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Địa chỉ thường trú" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" Height="44"/>
                                </StackPanel>
                            </Grid>

                            <!-- Status message feedback -->
                            <Border Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <TextBlock Text="⚠" Foreground="#B91C1C" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Submit Actions -->
                    <DockPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Lưu vào Database &amp; Cấp tài khoản" 
                                Command="{Binding SubmitAddStaffCommand}" 
                                Style="{StaticResource PrimaryButton}" Height="46" Padding="20,0"/>
                        <Button Content="Hủy bỏ" Command="{Binding CloseAddModalCommand}" 
                                Style="{StaticResource SecondaryButton}" Height="46" Width="100" HorizontalAlignment="Left"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
