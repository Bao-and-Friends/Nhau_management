<UserControl x:Class="RestaurantModern.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Metric Cards Row (Khớp Figma 6:39) -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Bàn đang có khách" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                        <TextBlock Text="{Binding OccupiedTables, StringFormat='{}{0:D2}'}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Đang phục vụ món" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Empty}" Margin="0,0,6,0"/>
                            <TextBlock Text="Bàn trống" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                        </DockPanel>
                        <TextBlock Text="{Binding EmptyTables, StringFormat='{}{0:D2}'}" Foreground="{StaticResource Brush.Status.Empty}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Sẵn sàng nhận khách" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Cleaning}" Margin="0,0,6,0"/>
                            <TextBlock Text="Chờ dọn" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                        </DockPanel>
                        <TextBlock Text="{Binding CleaningTables, StringFormat='{}{0:D2}'}" Foreground="{StaticResource Brush.Status.Cleaning}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Cần dọn dẹp vệ sinh" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Doanh thu đã thu" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                        <TextBlock Text="{Binding TodayRevenue, StringFormat='{}{0:N0} đ'}" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock Text="Cập nhật theo thời gian thực" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 2. Main Content Split: Bàn cần chú ý (Trái) & Thao tác nhanh (Phải) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Bàn cần chú ý (Figma 6:53) -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,20,0" Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right" Content="Xem tất cả bàn →" 
                                    Command="{Binding ViewAllTablesCommand}" 
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="14,4"/>
                            <StackPanel>
                                <TextBlock Text="Bàn cần chú ý" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                                <TextBlock Text="Theo dõi các bàn đang có khách hoặc cần xử lý" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Items List (Figma 6:55) -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveTables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,14">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right" Content="Xem bàn  →" 
                                                    Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Accent.Secondary}" 
                                                    FontWeight="Bold" FontSize="13" Cursor="Hand" Padding="8,4"/>

                                            <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBackground}" CornerRadius="6" Padding="10,4" Margin="0,0,20,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding StatusBadgeColor}" FontWeight="Bold" FontSize="12"/>
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TenBan}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Sức chứa: " Foreground="{StaticResource Brush.Text.Muted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding SucChua}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" người  •  Tạm tính: " Foreground="{StaticResource Brush.Text.Muted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding TongTienTamTinh, StringFormat='{}{0:N0} đ'}" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="12" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Right: Thao tác nhanh (Khớp Figma 6:71) -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Thao tác nhanh" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,16"/>

                            <!-- Quick Action 1: Mở quản lý bàn (Figma 6:73) -->
                            <Button Content="Mở quản lý bàn  →" Command="{Binding OpenTablesCommand}" Style="{StaticResource QuickActionButton}" Margin="0,0,0,12"/>

                            <!-- Quick Action 2: Mở màn hình thanh toán (Figma 6:75) -->
                            <Button Content="Mở màn hình thanh toán  →" Command="{Binding OpenPaymentCommand}" Style="{StaticResource QuickActionButton}" Margin="0,0,0,12"/>

                            <!-- Quick Action 3: Chat nội bộ (Figma 6:77) -->
                            <Button Content="Chat nội bộ  →" Command="{Binding OpenChatCommand}" Style="{StaticResource QuickActionButton}" Margin="0,0,0,12"/>

                            <!-- Quick Action 4: Xem hóa đơn (Figma 6:79) -->
                            <Button Content="Xem hóa đơn  →" Command="{Binding OpenInvoicesCommand}" Style="{StaticResource QuickActionButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card: Hoạt động theo phiên (Figma 6:81) -->
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Hoạt động theo phiên" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,6"/>
                            <TextBlock Text="Chọn bàn → Mở phiên → Gọi món → Yêu cầu thanh toán → Thu tiền → Chờ dọn → Dọn xong" 
                                       Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
