<UserControl x:Class="RestaurantModern.Views.PromoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header (Figma 7:223) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Actions Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Promos Table (Figma 7:228) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Heading -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ NHÀ HÀNG" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="Khuyến mãi" Foreground="{StaticResource Brush.Text.Dark}" FontWeight="Bold" FontSize="26"/>
                <TextBlock Text="Theo dõi chương trình ưu đãi, mã giảm giá và chính sách khuyến mãi nhà hàng." 
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Actions Bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="+ Thêm mã khuyến mãi" Command="{Binding AddPromoCommand}" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,4"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="320" Height="38" VerticalContentAlignment="Center" HorizontalAlignment="Left"
                         ToolTip="Tìm theo tên chương trình hoặc mã voucher..."/>
            </DockPanel>
        </Border>

        <!-- 3. Promos Table (Khớp Figma 7:228) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Chương trình ưu đãi đang áp dụng" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,14"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Headings (Figma 7:230) -->
                        <Grid Background="{StaticResource Brush.Surface.Subtle}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Chương trình" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="1" Text="Mã voucher" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="2" Text="Hình thức" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="3" Text="Điều kiện" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="4" Text="Hạn dùng" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="5" Text="Trạng thái" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                        </Grid>

                        <!-- Items (Figma 7:239) -->
                        <ItemsControl ItemsSource="{Binding FilteredPromos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TenChuongTrinh}" FontWeight="Bold" FontSize="14" Margin="14,0" VerticalAlignment="Center"/>
                                            
                                            <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MaVoucher}" Foreground="{StaticResource Brush.Accent.Secondary}" FontWeight="Bold" FontSize="12.5"/>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding HinhThuc}" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Bold" FontSize="13.5" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DieuKien}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding HanDung}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="13" Margin="14,0" VerticalAlignment="Center"/>

                                            <Border Grid.Column="5" Background="{Binding StatusBg}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding StatusFg}" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
