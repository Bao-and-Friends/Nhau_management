<UserControl x:Class="RestaurantModern.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (Figma 7:344) -->
            <RowDefinition Height="Auto"/>
            <!-- Chat Columns (Figma 7:349) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Heading -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ NHÀ HÀNG" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="Chat nội bộ" Foreground="{StaticResource Brush.Text.Dark}" FontWeight="Bold" FontSize="26"/>
                <TextBlock Text="Trao đổi công việc giữa các bộ phận phục vụ, thu ngân và bếp theo thời gian thực." 
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Chat Split: Left (Contacts) & Right (Chat Thread) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Card / Nhân viên trực tuyến (Figma 7:350) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Nhân viên trực tuyến" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,14"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="0,3"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="#F8FAFC" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#EDF2F9"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HoTen}" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Brush.Text.Dark}"/>
                                        <TextBlock Text="{Binding VaiTro}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Card / Trò chuyện nội bộ (Figma 7:358) -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Active Contact Header -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Messages List -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Input -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedContact.DisplayText, FallbackValue='Chọn một nhân viên để chat'}" 
                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                            <TextBlock Text="Đang hoạt động trong ca trực" Foreground="{StaticResource Brush.Status.Empty}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Grid.Row="1" Background="{StaticResource Brush.Divider}" Margin="0,0,0,14"/>

                    <!-- Messages ScrollView -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Border HorizontalAlignment="{Binding HorizontalAlign}" 
                                                Background="{Binding BubbleBackground}" 
                                                CornerRadius="12" Padding="14,10" MaxWidth="520">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding BubbleForeground}" FontSize="13.5" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Brush.Text.Muted}" FontSize="10.5" 
                                                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Input Box (Figma 7:366 - 7:370) -->
                    <DockPanel Grid.Row="3" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Gửi" Command="{Binding SendMessageCommand}" 
                                Style="{StaticResource PrimaryButton}" Width="90" Height="44" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="44" VerticalContentAlignment="Center"
                                 ToolTip="Nhập nội dung tin nhắn và nhấn Gửi..."/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
