<UserControl x:Class="RestaurantModern.Views.RevenueStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Doanh thu tháng này" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    <TextBlock Text="{Binding TongDoanhThuThang}" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Doanh thu hôm nay" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    <TextBlock Text="{Binding DoanhThuHomNay}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Số hóa đơn phục vụ" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    <TextBlock Text="{Binding SoHoaDonHomNay}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Món bán chạy nhất" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    <TextBlock Text="{Binding MonBanChayNhat}" Foreground="{StaticResource Brush.Status.Empty}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📈" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Biểu đồ thống kê doanh thu theo tuần / tháng" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Dữ liệu tổng hợp trực tiếp từ lịch sử thanh toán hóa đơn của nhà hàng" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>