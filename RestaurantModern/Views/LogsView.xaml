<UserControl x:Class="RestaurantModern.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header (Figma 7:404) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Actions Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Logs Table (Figma 7:409) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Heading -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ NHÀ HÀNG" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="Nhật ký hoạt động" Foreground="{StaticResource Brush.Text.Dark}" FontWeight="Bold" FontSize="26"/>
                <TextBlock Text="Lịch sử thao tác người dùng, biến động đơn hàng và kiểm toán dữ liệu vận hành." 
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Actions Bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Làm mới nhật ký" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="38" Padding="14,4"/>

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="340" Height="38" VerticalContentAlignment="Center" HorizontalAlignment="Left"
                         ToolTip="Tìm theo tên nhân viên, chức năng hoặc hành động..."/>
            </DockPanel>
        </Border>

        <!-- 3. Logs Table (Khớp Figma 7:409) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Nhật ký hệ thống gần đây" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,14"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Headings (Figma 7:411) -->
                        <Grid Background="{StaticResource Brush.Surface.Subtle}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thời gian" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="1" Text="Người thực hiện" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="2" Text="Chức năng" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="3" Text="Hành động" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="4" Text="Kết quả" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                        </Grid>

                        <!-- Items (Figma 7:422) -->
                        <ItemsControl ItemsSource="{Binding FilteredLogs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding ThoiGian}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding NguoiThucHien}" FontWeight="Bold" FontSize="13.5" Margin="14,0" VerticalAlignment="Center"/>
                                            
                                            <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChucNang}" Foreground="{StaticResource Brush.Accent.Secondary}" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="{Binding HanhDong}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="13" TextWrapping="Wrap" Margin="14,0" VerticalAlignment="Center"/>

                                            <Border Grid.Column="4" Background="{Binding ResultBg}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KetQua}" Foreground="{Binding ResultFg}" FontWeight="Bold" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
