<UserControl x:Class="RestaurantModern.Views.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Header (Figma 6:427) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Filters & Actions Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Invoices DataGrid (Figma 6:432) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Heading -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ NHÀ HÀNG" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Text="Hóa đơn" Foreground="{StaticResource Brush.Text.Dark}" FontWeight="Bold" FontSize="26"/>
                <TextBlock Text="Danh sách hóa đơn, xem trước phiếu thanh toán và quản lý lịch sử thu ngân." 
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2. Filters Bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Mở quản lý bàn →" Command="{Binding OpenTablesCommand}" Style="{StaticResource PrimaryButton}" Height="38" Padding="14,4"/>

                <TextBox DockPanel.Dock="Right" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="260" Height="38" VerticalContentAlignment="Center" Margin="0,0,14,0"
                         ToolTip="Tìm theo mã HĐ hoặc số bàn..."/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tất cả" Command="{Binding FilterCommand}" CommandParameter="Tất cả" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,8,0"/>
                    <Button Content="Chờ thanh toán" Command="{Binding FilterCommand}" CommandParameter="Chờ thanh toán" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,8,0"/>
                    <Button Content="Đã thanh toán" Command="{Binding FilterCommand}" CommandParameter="Đã thanh toán" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Invoices Card / DataGrid (Khớp Figma 6:432) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Danh sách hóa đơn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" Margin="0,0,0,14"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Table Header (Figma 6:434) -->
                        <Grid Background="{StaticResource Brush.Surface.Subtle}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mã HĐ" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="1" Text="Bàn" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="2" Text="Ngày lập" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="3" Text="Thu ngân" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="4" Text="Thành tiền" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="5" Text="Phương thức" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="6" Text="Trạng thái" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                            <TextBlock Grid.Column="7" Text="Thao tác" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="14,10"/>
                        </Grid>

                        <!-- Items List (Figma 6:447) -->
                        <ItemsControl ItemsSource="{Binding FilteredInvoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding MaHD}" FontWeight="Bold" FontSize="13.5" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TenBan}" FontWeight="SemiBold" FontSize="13.5" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding NgayLap, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding NhanVienLap}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="13" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TongTien, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="14" Margin="14,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding PhuongThuc}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="14,0" VerticalAlignment="Center"/>
                                            
                                            <Border Grid.Column="6" Background="{Binding StatusBg}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TrangThai}" Foreground="{Binding StatusFg}" FontWeight="Bold" FontSize="12"/>
                                            </Border>

                                            <Button Grid.Column="7" Content="Xem / In" 
                                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Height="30" Padding="10,2" Margin="14,0" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
