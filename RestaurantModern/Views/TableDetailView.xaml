<UserControl x:Class="RestaurantModern.Views.TableDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top 4 Metric Cards (Figma 6:259) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. DataGrid: Các món trong phiên (Figma 6:272) -->
            <RowDefinition Height="*"/>
            <!-- 3. Bottom Action Buttons (Figma 6:310 & 52:4) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Selected Table Metrics (Khớp Figma 6:259) -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
            <!-- Tên bàn -->
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="Tên bàn" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                    <TextBlock Text="{Binding Table.TenBan}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Sức chứa -->
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="Sức chứa" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                    <TextBlock Text="{Binding Table.SucChua, StringFormat='{}{0} chỗ ngồi'}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Trạng thái -->
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="Trạng thái" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                    <TextBlock Text="{Binding Table.TrangThai}" Foreground="{Binding Table.StatusBadgeColor}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Giờ bắt đầu / Tạm tính -->
            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Tổng tạm tính" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} đ'}" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 2. Card / DataGrid / Các món trong phiên (Khớp Figma 6:272) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="+ Thêm món ngay" Click="OpenOrderModal_Click" Style="{StaticResource PrimaryButton}" Height="36" Padding="14,4"/>
                    <TextBlock Text="Các món trong phiên phục vụ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Table Column Headers (Figma 6:274) -->
                        <Grid Background="{StaticResource Brush.Surface.Subtle}" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Món ăn" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,10"/>
                            <TextBlock Grid.Column="1" Text="Số lượng" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,10"/>
                            <TextBlock Grid.Column="2" Text="Đơn giá" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,10"/>
                            <TextBlock Grid.Column="3" Text="Thành tiền" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,10"/>
                            <TextBlock Grid.Column="4" Text="Xóa" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="16,10"/>
                        </Grid>

                        <!-- Items Rows (Figma 6:283) -->
                        <ItemsControl ItemsSource="{Binding OrderItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TenMon}" FontWeight="Bold" FontSize="14.5" Margin="16,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SoLuong, StringFormat='{}{0} phần'}" FontSize="14" Margin="16,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DonGia, StringFormat='{}{0:N0} đ'}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="14" Margin="16,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}" FontSize="14.5" Margin="16,0" VerticalAlignment="Center"/>
                                            <Button Grid.Column="4" Content="✕" 
                                                    Command="{Binding DataContext.RemoveDishCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Status.Danger}" 
                                                    FontWeight="Bold" FontSize="14" Cursor="Hand" Margin="16,0" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Totals Summary Row -->
                <Border Grid.Row="2" Background="{StaticResource Brush.Surface.Subtle}" CornerRadius="10" Padding="16,12" Margin="0,14,0,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Tạm tính: " Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="13" Margin="0,0,20,0"/>
                            <TextBlock Text="VAT (8%): " Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                            <TextBlock Text="{Binding Vat, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Tổng thanh toán: " FontWeight="Bold" FontSize="15" Foreground="{StaticResource Brush.Text.Dark}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Brush.Accent.Primary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Bottom Session Actions (Khớp Figma 6:310 & Frame 52:4) -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14">
            <DockPanel LastChildFill="False">
                <!-- Action Buttons Left: Gọi món, Chuyển bàn, Gộp bàn -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Button / Gọi món (Figma 6:311 & 52:93) -->
                    <Button Content="Gọi món" Click="OpenOrderModal_Click" Style="{StaticResource PrimaryButton}" Width="150" Height="42" Margin="0,0,12,0"/>
                    
                    <!-- Button / Chuyển bàn (Figma 52:359) -->
                    <Button Content="Chuyển bàn" Click="OpenTransferModal_Click" Style="{StaticResource SecondaryButton}" Width="140" Height="42" Margin="0,0,12,0"/>
                    
                    <!-- Button / Gộp bàn -->
                    <Button Content="Gộp bàn" Click="OpenMergeModal_Click" Style="{StaticResource SecondaryButton}" Width="130" Height="42" Margin="0,0,12,0"/>
                    
                    <!-- Button / Yêu cầu thanh toán (Figma 6:313) -->
                    <Button Content="Yêu cầu thanh toán" Command="{Binding PayCommand}" Style="{StaticResource SecondaryButton}" Width="190" Height="42"/>
                </StackPanel>

                <!-- Button / Quay lại (Figma 6:315) -->
                <Button DockPanel.Dock="Right" Content="← Quay lại sơ đồ bàn" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" Width="180" Height="42"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
