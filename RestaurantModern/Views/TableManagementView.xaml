<UserControl x:Class="RestaurantModern.Views.TableManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Top 4 Metric Cards (Figma 6:123) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Status Filters Bar (Figma 6:136) -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Dynamic Tables Grid (Figma 6:147) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top 4 Status Metric Cards (Khớp Figma 6:123) -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
            <!-- Tổng số bàn -->
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="17">
                <StackPanel>
                    <TextBlock Text="Tổng số bàn" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    <TextBlock Text="{Binding FilteredTables.Count, StringFormat='{}{0:D2}'}" Foreground="{StaticResource Brush.Text.Dark}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Trống -->
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="17">
                <StackPanel>
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Empty}" Margin="0,0,6,0"/>
                        <TextBlock Text="Trống" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    </DockPanel>
                    <TextBlock Text="05" Foreground="{StaticResource Brush.Status.Empty}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Có Khách -->
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="17">
                <StackPanel>
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Occupied}" Margin="0,0,6,0"/>
                        <TextBlock Text="Có Khách" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    </DockPanel>
                    <TextBlock Text="04" Foreground="{StaticResource Brush.Accent.Primary}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Chờ Dọn -->
            <Border Style="{StaticResource Card}" Padding="17">
                <StackPanel>
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Status.Cleaning}" Margin="0,0,6,0"/>
                        <TextBlock Text="Chờ Dọn" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13"/>
                    </DockPanel>
                    <TextBlock Text="01" Foreground="{StaticResource Brush.Status.Cleaning}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 2. Status Filters Bar (Khớp Figma 6:136) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,20">
            <DockPanel LastChildFill="True">
                <!-- Action Buttons Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Width="220" Height="36" VerticalContentAlignment="Center" Margin="0,0,10,0"
                             ToolTip="Tìm theo tên hoặc mã bàn..."/>
                    <Button Content="+ Thêm bàn" Click="AddTable_Click" Style="{StaticResource PrimaryButton}" Height="36" Padding="16,4"/>
                </StackPanel>

                <!-- Filter Pills Left (Figma 6:136) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tất cả" Command="{Binding FilterCommand}" CommandParameter="Tất cả" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,8,0"/>
                    <Button Content="Trống" Command="{Binding FilterCommand}" CommandParameter="Trống" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,8,0"/>
                    <Button Content="Có Khách" Command="{Binding FilterCommand}" CommandParameter="Có Khách" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,8,0"/>
                    <Button Content="Đã Đặt" Command="{Binding FilterCommand}" CommandParameter="Đã Đặt" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2" Margin="0,0,8,0"/>
                    <Button Content="Chờ Dọn" Command="{Binding FilterCommand}" CommandParameter="Chờ Dọn" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. Table Cards Grid (Khớp Figma 6:147: Thẻ bàn 360 x 170) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredTables}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Khớp Frame 6:148: width=350, height=170 -->
                        <Border Style="{StaticResource Card}" Width="350" Height="170" Margin="0,0,18,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table Heading: Tên bàn (25px) & Status Badge (Figma 6:149) -->
                                <DockPanel Grid.Row="0">
                                    <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBackground}" CornerRadius="6" Padding="12,4">
                                        <TextBlock Text="{Binding TrangThai}" Foreground="{Binding StatusBadgeColor}" FontWeight="Bold" FontSize="12.5"/>
                                    </Border>
                                    <TextBlock Text="{Binding TenBan}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Dark}"/>
                                </DockPanel>

                                <!-- Subtitle: Sức chứa & Mã bàn (Figma 6:153) -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13.5">
                                        <Run Text="{Binding SucChua}"/>
                                        <Run Text=" chỗ ngồi  •  Khu vực: "/>
                                        <Run Text="{Binding KhuVuc}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Button: Xem / thao tác (Figma 6:154: width 150, height 40) -->
                                <Button Grid.Row="2" Content="Xem / thao tác" 
                                        Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource SecondaryButton}" Width="150" Height="40" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
