<UserControl x:Class="RestaurantModern.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Profile Info -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
            <StackPanel>
                <StackPanel HorizontalAlignment="Center" Margin="0,16,0,24">
                    <Border Background="{StaticResource Brush.Auth.LogoBg}" CornerRadius="35" Width="70" Height="70" HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding HoTen}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <Border Background="{StaticResource Brush.Accent.SecondaryLight}" CornerRadius="6" Padding="10,3" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding VaiTro}" Foreground="{StaticResource Brush.Accent.Secondary}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>

                <Separator Background="{StaticResource Brush.Divider}" Margin="0,0,0,18"/>

                <DockPanel Margin="0,8">
                    <TextBlock Text="Mã nhân viên:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13.5"/>
                    <TextBlock Text="{Binding MaNV}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                </DockPanel>

                <DockPanel Margin="0,8">
                    <TextBlock Text="Số điện thoại:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13.5"/>
                    <TextBlock Text="{Binding SoDienThoai}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                </DockPanel>

                <DockPanel Margin="0,8">
                    <TextBlock Text="Địa chỉ làm việc:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13.5"/>
                    <TextBlock Text="{Binding DiaChi}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Right: Change Password Form -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                <TextBlock Text="Đổi mật khẩu tài khoản" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Cập nhật mật khẩu định kỳ để bảo vệ tài khoản nội bộ" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,0,0,20"/>

                <TextBlock Text="Mật khẩu hiện tại:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,0,0,4"/>
                <PasswordBox Height="44" Margin="0,0,0,14"/>

                <TextBlock Text="Mật khẩu mới:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,14"/>

                <TextBlock Text="Xác nhận mật khẩu mới:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12.5" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Height="44" Margin="0,0,0,18"/>

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Accent.Primary}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14"/>

                <Button Content="Lưu mật khẩu mới" Command="{Binding ChangePasswordCommand}" Style="{StaticResource PrimaryButton}" Height="46" Width="200" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>