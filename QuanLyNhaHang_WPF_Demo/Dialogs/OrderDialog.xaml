<Window x:Class="QuanLyNhaHang.Dialogs.OrderDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gọi món" Width="1180" Height="780" MaxHeight="850" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource Bg}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Heading" FontSize="26" FontWeight="Bold" Margin="0,0,0,12"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Thực đơn" FontSize="20" FontWeight="Bold"/><TextBox x:Name="Search" ToolTip="Tìm món"/><ComboBox x:Name="Category" SelectedIndex="0"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Món chính"/><ComboBoxItem Content="Món ăn kèm"/><ComboBoxItem Content="Đồ uống"/></ComboBox><Button x:Name="Add" Content="+ Chọn món" Style="{StaticResource Secondary}"/></StackPanel><DataGrid x:Name="Foods" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding Name}"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding PriceText}"/></DataGrid.Columns></DataGrid></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False"><StackPanel><TextBlock Text="Món đã xác nhận" FontSize="19" FontWeight="Bold"/><DataGrid x:Name="Confirmed" Height="180" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding Name}"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Tiền" Binding="{Binding TotalText}"/></DataGrid.Columns></DataGrid><TextBlock Text="Danh sách chuẩn bị thêm" FontSize="19" FontWeight="Bold"/><DataGrid x:Name="Draft" Height="180" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding Name}"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Tiền" Binding="{Binding TotalText}"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,0,0,12"><Button x:Name="Minus" Content="−" Style="{StaticResource Secondary}"/><Button x:Name="Plus" Content="+" Style="{StaticResource Secondary}"/><Button x:Name="Clear" Content="Bỏ các món tạm" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock x:Name="Total" FontWeight="Bold" FontSize="18"/></StackPanel></ScrollViewer></Border></Grid><DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Back" Content="Quay lại bàn" Style="{StaticResource Secondary}"/><Button x:Name="Commit" Content="Xác nhận thêm món"/></StackPanel></DockPanel></Grid></Window>