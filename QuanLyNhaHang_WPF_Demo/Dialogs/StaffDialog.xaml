<Window x:Class="QuanLyNhaHang.Dialogs.StaffDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nhân viên và tài khoản" Width="980" Height="830" MaxHeight="850" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource Bg}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Heading" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/><ScrollViewer Grid.Row="1" CanContentScroll="False" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01  Thông tin nhân viên" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><UniformGrid Columns="2"><StackPanel Margin="0,0,15,4"><TextBlock Text="Mã nhân viên" FontWeight="SemiBold"/><TextBox x:Name="Code"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Họ và tên" FontWeight="SemiBold"/><TextBox x:Name="NameInput"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Ngày sinh" /><DatePicker x:Name="Birthday"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Giới tính" /><ComboBox x:Name="Gender" SelectedIndex="0"><ComboBoxItem Content="Nam"/><ComboBoxItem Content="Nữ"/><ComboBoxItem Content="Khác"/><ComboBoxItem Content="Không muốn nêu"/></ComboBox></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Số điện thoại" FontWeight="SemiBold"/><TextBox x:Name="Phone"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Email" FontWeight="SemiBold"/><TextBox x:Name="Email"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Địa chỉ" FontWeight="SemiBold"/><TextBox x:Name="Address"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Vai trò" /><ComboBox x:Name="Role" SelectedIndex="0"><ComboBoxItem Content="Quản lý"/><ComboBoxItem Content="Thu ngân"/><ComboBoxItem Content="Phục vụ"/></ComboBox></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Trạng thái nhân viên" /><ComboBox x:Name="Status" SelectedIndex="0"><ComboBoxItem Content="Đang làm việc"/><ComboBoxItem Content="Tạm nghỉ"/><ComboBoxItem Content="Đã nghỉ"/></ComboBox></StackPanel></UniformGrid></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02  Thông tin tài khoản" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><UniformGrid Columns="2"><StackPanel Margin="0,0,15,4"><TextBlock Text="Mã tài khoản" FontWeight="SemiBold"/><TextBox x:Name="AccountCode"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Tên đăng nhập" FontWeight="SemiBold"/><TextBox x:Name="Username"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Mật khẩu" FontWeight="SemiBold"/><PasswordBox x:Name="Password"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Xác nhận mật khẩu" FontWeight="SemiBold"/><PasswordBox x:Name="Confirm"/></StackPanel><StackPanel Margin="0,0,15,4"><TextBlock Text="Trạng thái tài khoản" /><ComboBox x:Name="AccountStatus" SelectedIndex="0"><ComboBoxItem Content="Hoạt động"/><ComboBoxItem Content="Khóa"/></ComboBox></StackPanel></UniformGrid></StackPanel></Border></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Hủy" Style="{StaticResource Secondary}"/><Button x:Name="Save" Content="Lưu nhân viên &amp; tài khoản"/></StackPanel></Grid></Window>