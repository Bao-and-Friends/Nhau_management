<Window x:Class="QuanLyNhaHang.Dialogs.TableDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chi tiết bàn" Width="600" Height="630" MaxHeight="850" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource Bg}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="Heading" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="Info" Margin="0,8"/></StackPanel><StackPanel Grid.Row="1"><DataGrid x:Name="Orders" Height="320" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding Name}"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Tiền" Binding="{Binding TotalText}"/></DataGrid.Columns></DataGrid><TextBlock x:Name="Total" FontWeight="Bold" FontSize="20"/></StackPanel><WrapPanel Grid.Row="2"><Button x:Name="Open" Content="Mở bàn"/><Button x:Name="Reserve" Content="Đánh dấu Đã Đặt" Style="{StaticResource Secondary}"/><Button x:Name="Order" Content="Gọi món"/><Button x:Name="Invoice" Content="Yêu cầu thanh toán" Style="{StaticResource Secondary}"/><Button x:Name="Clean" Content="Đã dọn xong"/><Button x:Name="Back" Content="Đóng" Style="{StaticResource Secondary}"/></WrapPanel></Grid></Window>