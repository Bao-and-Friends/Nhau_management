<Window x:Class="QuanLyNhaHang.Dialogs.InvoiceEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chỉnh sửa hóa đơn" Width="860" Height="720" MaxHeight="850" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource Bg}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Phương thức thanh toán" /><ComboBox x:Name="Method" SelectedIndex="0"><ComboBoxItem Content="Tiền mặt"/><ComboBoxItem Content="Chuyển khoản"/></ComboBox></StackPanel><StackPanel Grid.Row="1"><DataGrid x:Name="Rows" Height="270" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Món" Binding="{Binding Name}"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Tiền" Binding="{Binding TotalText}"/></DataGrid.Columns></DataGrid><WrapPanel Margin="0,0,0,12"><Button x:Name="Minus" Content="−" Style="{StaticResource Secondary}"/><Button x:Name="Plus" Content="+" Style="{StaticResource Secondary}"/></WrapPanel><ComboBox x:Name="Food" DisplayMemberPath="Name"/><Button x:Name="Add" Content="+ Thêm món" Style="{StaticResource Secondary}"/><TextBlock x:Name="Total" FontSize="20" FontWeight="Bold"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Hủy" Style="{StaticResource Secondary}"/><Button x:Name="Save" Content="Lưu thay đổi"/></StackPanel></Grid></Window>