<Window x:Class="QuanLyNhaHang.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QUẢN LÝ NHÀ HÀNG"
        Width="1440" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Ink}" Background="{StaticResource Bg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <ContentControl x:Name="AuthHost"/>
        <Grid x:Name="Shell" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Navy}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="QUẢN LÝ NHÀ HÀNG" FontSize="20"
                                   FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="HỆ THỐNG NỘI BỘ" Foreground="#A4B7CF"
                                   FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel x:Name="Navigation"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="UserLabel" Foreground="White" Margin="0,10"/>
                        <Button x:Name="Logout" Content="Đăng xuất" Style="{StaticResource Secondary}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="30,24,30,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="25"/>
                        <RowDefinition Height="Auto" MinHeight="46"/>
                        <RowDefinition Height="Auto" MinHeight="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="QUẢN LÝ NHÀ HÀNG" FontSize="12"
                               Foreground="{StaticResource Orange}" FontWeight="Bold"
                               Margin="0,0,12,7" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="PageTitle"
                               FontSize="30" FontWeight="Bold" Foreground="{StaticResource Ink}"
                               Margin="0,0,12,8" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="PageSubtitle"
                               Foreground="{StaticResource Muted}"
                               Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                            x:Name="ResetDemo" Style="{StaticResource Secondary}"
                            Content="Đặt lại demo" VerticalAlignment="Top"/>
                </Grid>
                <ContentControl x:Name="ViewHost" Grid.Row="1"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
