<UserControl x:Class="QuanLyNhaHang.Views.InvoicesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><WrapPanel Margin="0,0,0,12"><Button x:Name="Edit" Content="Chỉnh sửa" Style="{StaticResource Secondary}"/><Button x:Name="Preview" Content="Xem / In"/><Button x:Name="GoTables" Content="Quản lý bàn" Style="{StaticResource Secondary}"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Danh sách hóa đơn" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Rows" Height="480" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Mã HĐ" Binding="{Binding Id}"/><DataGridTextColumn Header="Bàn" Binding="{Binding TableName}"/><DataGridTextColumn Header="Ngày lập" Binding="{Binding Created}"/><DataGridTextColumn Header="Tổng tiền hàng" Binding="{Binding SubtotalText}"/><DataGridTextColumn Header="Cần thu" Binding="{Binding DueText}"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>