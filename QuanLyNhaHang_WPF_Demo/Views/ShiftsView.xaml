<UserControl x:Class="QuanLyNhaHang.Views.ShiftsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Phân công ca theo ngày" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Rows" Height="450" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Nhân viên" Binding="{Binding Name}"/><DataGridTextColumn Header="Vai trò" Binding="{Binding Role}"/><DataGridTextColumn Header="Ca trực" Binding="{Binding Shift}"/><DataGridTextColumn Header="Thời gian" Binding="{Binding Time}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>