<UserControl x:Class="QuanLyNhaHang.Views.PaymentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><UniformGrid Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Hóa đơn chờ" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Waiting" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Đã thu" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Paid" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Doanh thu đã thu" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Revenue" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Bàn chờ dọn" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Cleaning" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Danh sách hóa đơn chờ" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Bills" Height="320" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Mã HĐ" Binding="{Binding Id}"/><DataGridTextColumn Header="Bàn" Binding="{Binding TableName}"/><DataGridTextColumn Header="Thành tiền" Binding="{Binding SubtotalText}"/></DataGrid.Columns></DataGrid></StackPanel></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Thanh toán" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock x:Name="Selected" FontSize="18" FontWeight="Bold" Margin="0,8"/><TextBlock Text="Giảm giá" /><ComboBox x:Name="Discount" SelectedIndex="0"><ComboBoxItem Content="Không áp dụng"/><ComboBoxItem Content="Giảm 10%"/></ComboBox><TextBlock Text="Phương thức thanh toán" /><ComboBox x:Name="Method" SelectedIndex="0"><ComboBoxItem Content="Tiền mặt"/><ComboBoxItem Content="Chuyển khoản"/></ComboBox><TextBlock Text="Số tiền khách đưa" FontWeight="SemiBold"/><TextBox x:Name="Received"/><TextBlock x:Name="Due" FontWeight="Bold" FontSize="18"/><TextBlock x:Name="Change" Margin="0,10"/><WrapPanel Margin="0,0,0,12"><Button x:Name="Edit" Content="Chỉnh sửa hóa đơn" Style="{StaticResource Secondary}"/><Button x:Name="Pay" Content="Xác nhận thanh toán"/></WrapPanel></StackPanel></Border></StackPanel></Grid></StackPanel></ScrollViewer></UserControl>