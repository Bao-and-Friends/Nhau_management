<UserControl x:Class="QuanLyNhaHang.Views.StaffView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><WrapPanel Margin="0,0,0,12"><Button x:Name="Add" Content="+ Thêm nhân viên"/><Button x:Name="Edit" Content="Chỉnh sửa" Style="{StaticResource Secondary}"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Nhân viên và tài khoản" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Rows" Height="480" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Mã NV" Binding="{Binding Id}"/><DataGridTextColumn Header="Họ tên" Binding="{Binding Name}"/><DataGridTextColumn Header="Vai trò" Binding="{Binding Role}"/><DataGridTextColumn Header="Email" Binding="{Binding Email}"/><DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}"/><DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>