<UserControl x:Class="QuanLyNhaHang.Views.PromosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Khuyến mãi" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Rows" Height="300" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Chương trình" Binding="{Binding Name}"/><DataGridTextColumn Header="Hình thức" Binding="{Binding Percent}"/><DataGridTextColumn Header="Điều kiện" Binding="{Binding Condition}"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>