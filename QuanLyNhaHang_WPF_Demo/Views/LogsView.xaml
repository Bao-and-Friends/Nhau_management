<UserControl x:Class="QuanLyNhaHang.Views.LogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Nhật ký hoạt động" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Rows" Height="520" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding At}"/><DataGridTextColumn Header="Tài khoản" Binding="{Binding Who}"/><DataGridTextColumn Header="Nội dung" Binding="{Binding Detail}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>