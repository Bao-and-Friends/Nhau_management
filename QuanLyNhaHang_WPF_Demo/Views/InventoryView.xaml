<UserControl x:Class="QuanLyNhaHang.Views.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><WrapPanel Margin="0,0,0,12"><Button x:Name="Receive" Content="+ Nhập kho"/><Button x:Name="Add" Content="+ Thêm nguyên liệu" Style="{StaticResource Secondary}"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tồn kho hiện tại" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Rows" Height="430" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Nguyên liệu" Binding="{Binding Name}"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}"/><DataGridTextColumn Header="Hiện có" Binding="{Binding Quantity}"/><DataGridTextColumn Header="Tối thiểu" Binding="{Binding Min}"/><DataGridTextColumn Header="Tình trạng" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>