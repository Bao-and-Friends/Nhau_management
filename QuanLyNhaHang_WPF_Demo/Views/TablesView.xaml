<UserControl x:Class="QuanLyNhaHang.Views.TablesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel Margin="0,0,8,0">
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Tổng số bàn" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="All" FontSize="26" FontWeight="Bold" Margin="0,8"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Trống" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="Free" FontSize="26" FontWeight="Bold" Margin="0,8"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Có Khách" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="Busy" FontSize="26" FontWeight="Bold" Margin="0,8"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Chờ Dọn" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="Cleaning" FontSize="26" FontWeight="Bold" Margin="0,8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                <ComboBox x:Name="Filter"
              SelectedIndex="0"
              Width="150"
              Margin="0,0,18,0">
                    <ComboBoxItem Content="Tất cả"/>
                    <ComboBoxItem Content="Trống"/>
                    <ComboBoxItem Content="Có Khách"/>
                    <ComboBoxItem Content="Đã Đặt"/>
                    <ComboBoxItem Content="Chờ Dọn"/>
                </ComboBox>

                <Button x:Name="Add"
            Content="+ Thêm bàn"
            Padding="22,12"
            Margin="0,0,0,0"/>
            </WrapPanel>
            <WrapPanel x:Name="TableCards"/></StackPanel></ScrollViewer></UserControl>