<UserControl x:Class="QuanLyNhaHang.Views.ReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><UniformGrid Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Doanh thu thực thu" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Revenue" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Hóa đơn đã thanh toán" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Paid" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Giá trị trung bình" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Average" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Bàn đang hoạt động" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Busy" FontSize="26" FontWeight="Bold" Margin="0,8"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Thống kê doanh thu" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><WrapPanel Margin="0,0,0,12"><ComboBox x:Name="Range" SelectedIndex="0"><ComboBoxItem Content="Ngày"/><ComboBoxItem Content="Tuần"/><ComboBoxItem Content="Tháng"/></ComboBox></WrapPanel><DataGrid x:Name="Rows" Height="350" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Ngày" Binding="{Binding Day}"/><DataGridTextColumn Header="Doanh thu" Binding="{Binding Revenue}"/><DataGridTextColumn Header="Số hóa đơn" Binding="{Binding Count}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>