<UserControl x:Class="QuanLyNhaHang.Views.OtpView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.Background><RadialGradientBrush Center="0.15,0.2" GradientOrigin="0.15,0.2"><GradientStop Color="#CCE3FB" Offset="0"/><GradientStop Color="#7DA8D6" Offset="0.35"/><GradientStop Color="#214977" Offset="1"/></RadialGradientBrush></Grid.Background><Border Background="White" CornerRadius="30" Margin="32" MaxWidth="1240" MaxHeight="760" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions><Border Background="#F5F9FF" CornerRadius="22" Padding="20"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="160" Height="160" Background="#F9FBFF" BorderBrush="#193559" BorderThickness="3" CornerRadius="30" HorizontalAlignment="Center"><TextBlock Text="🍽" FontFamily="Segoe UI Emoji" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Quản Lý&#x0a;Nhà Hàng" FontWeight="Bold" FontSize="48" TextAlignment="Center" Margin="0,22"/></StackPanel></Border><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel MaxWidth="470" Margin="32,24" VerticalAlignment="Center"><TextBlock Text="Nhập mã OTP" FontSize="34" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="Mã gồm 6 chữ số, có hiệu lực trong 2 phút." Foreground="{StaticResource Muted}" Margin="0,0,0,22"/><TextBlock Text="Mã xác thực gồm 6 số" FontWeight="Bold"/><UniformGrid Columns="6" Margin="0,12,0,10"><TextBox x:Name="Digit0" FontSize="28" FontWeight="Bold" Height="65" Margin="3" TextAlignment="Center" VerticalContentAlignment="Center"/><TextBox x:Name="Digit1" FontSize="28" FontWeight="Bold" Height="65" Margin="3" TextAlignment="Center" VerticalContentAlignment="Center"/><TextBox x:Name="Digit2" FontSize="28" FontWeight="Bold" Height="65" Margin="3" TextAlignment="Center" VerticalContentAlignment="Center"/><TextBox x:Name="Digit3" FontSize="28" FontWeight="Bold" Height="65" Margin="3" TextAlignment="Center" VerticalContentAlignment="Center"/><TextBox x:Name="Digit4" FontSize="28" FontWeight="Bold" Height="65" Margin="3" TextAlignment="Center" VerticalContentAlignment="Center"/><TextBox x:Name="Digit5" FontSize="28" FontWeight="Bold" Height="65" Margin="3" TextAlignment="Center" VerticalContentAlignment="Center"/></UniformGrid><TextBlock x:Name="Countdown" Margin="0,8"/><Button x:Name="Submit" Content="Xác minh OTP"/><Button x:Name="Resend" Content="Gửi lại mã" Style="{StaticResource Secondary}"/><Button x:Name="Back" Content="Quay lại" Style="{StaticResource Secondary}"/></StackPanel></ScrollViewer></Grid></Border></Grid></UserControl>