<UserControl x:Class="QuanLyNhaHang.Views.SignupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.Background><RadialGradientBrush Center="0.15,0.2" GradientOrigin="0.15,0.2"><GradientStop Color="#CCE3FB" Offset="0"/><GradientStop Color="#7DA8D6" Offset="0.35"/><GradientStop Color="#214977" Offset="1"/></RadialGradientBrush></Grid.Background><Border Background="White" CornerRadius="30" Margin="32" MaxWidth="1240" MaxHeight="760" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions><Border Background="#F5F9FF" CornerRadius="22" Padding="20"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="160" Height="160" Background="#F9FBFF" BorderBrush="#193559" BorderThickness="3" CornerRadius="30" HorizontalAlignment="Center"><TextBlock Text="🍽" FontFamily="Segoe UI Emoji" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Quản Lý&#x0a;Nhà Hàng" FontWeight="Bold" FontSize="48" TextAlignment="Center" Margin="0,22"/></StackPanel></Border><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel MaxWidth="470" Margin="32,24" VerticalAlignment="Center"><TextBlock Text="Đăng ký tài khoản" FontSize="34" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="Yêu cầu cấp tài khoản nhân viên." Foreground="{StaticResource Muted}" Margin="0,0,0,22"/><TextBlock Text="Họ tên" FontWeight="SemiBold"/><TextBox x:Name="NameInput"/><TextBlock Text="Mã nhân viên" FontWeight="SemiBold"/><TextBox x:Name="CodeInput"/><TextBlock Text="Tên đăng nhập" FontWeight="SemiBold"/><TextBox x:Name="Username"/><Button x:Name="Submit" Content="Gửi yêu cầu đăng ký"/><Button x:Name="Back" Content="Quay lại đăng nhập" Style="{StaticResource Secondary}"/></StackPanel></ScrollViewer></Grid></