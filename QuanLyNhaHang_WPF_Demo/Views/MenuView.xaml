<UserControl x:Class="QuanLyNhaHang.Views.MenuView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel Margin="0,0,8,0"><WrapPanel Margin="0,0,0,12"><Button x:Name="Add" Content="+ Thêm món"/><Button x:Name="Edit" Content="Chỉnh sửa" Style="{StaticResource Secondary}"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Thực đơn" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="Rows" Height="500" Margin="0,8" ColumnWidth="*"><DataGrid.Columns><DataGridTextColumn Header="Mã món" Binding="{Binding Code}"/><DataGridTextColumn Header="Tên món" Binding="{Binding Name}"/><DataGridTextColumn Header="Danh mục" Binding="{Binding Category}"/><DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}"/><DataGridTextColumn Header="Đơn giá" Binding="{Binding PriceText}"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid></StackPanel></Border></StackPanel></ScrollViewer></UserControl>